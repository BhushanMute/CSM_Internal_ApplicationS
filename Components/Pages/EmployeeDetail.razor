    private void CancelEdit()
    {
        if (originalEmployee != null && employee != null)
        {
            // Restore all fields from the clone
            var props = typeof(Employee).GetProperties();
            foreach (var prop in props)
            {
                if (prop.CanWrite)
                {
                    prop.SetValue(employee, prop.GetValue(originalEmployee));
                }
            }
        }
        isEditMode = false;
    }

    private async Task HandleSave()
    {
        if (employee == null) return;

        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await EmployeeRepository.UpdateAsync(employee);

            if (result > 0)
            {
                originalEmployee = CloneEmployee(employee);
                isEditMode = false;
                successMessage = "Employee profile has been updated successfully!";

                // Auto-dismiss after 5 seconds
                _ = Task.Run(async () =>
                {
                    await Task.Delay(5000);
                    await InvokeAsync(() => { successMessage = null; StateHasChanged(); });
                });
            }
            else
            {
                errorMessage = "Failed to update employee. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating employee {EmployeeCode}", EmployeeCode);
            errorMessage = "An error occurred while saving. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete()
    {
        showDeleteModal = true;
    }

    private async Task DeleteEmployee()
    {
        isDeleting = true;

        try
        {
            var result = await EmployeeRepository.DeleteAsync(EmployeeCode);

            if (result > 0)
            {
                Navigation.NavigateTo("/employees");
            }
            else
            {
                errorMessage = "Failed to delete employee.";
                showDeleteModal = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting employee {EmployeeCode}", EmployeeCode);
            errorMessage = "An error occurred while deleting. Please try again.";
            showDeleteModal = false;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/employees");
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetTenure(DateTime? doj)
    {
        if (!doj.HasValue) return "N/A";
        var span = DateTime.Now - doj.Value;
        var years = (int)(span.TotalDays / 365.25);
        var months = (int)((span.TotalDays % 365.25) / 30.44);
        if (years > 0) return $"{years}y {months}m";
        if (months > 0) return $"{months} months";
        return $"{(int)span.TotalDays} days";
    }

    private string MaskAadhaar(string? aadhaar)
    {
        if (string.IsNullOrEmpty(aadhaar)) return EmptyText();
        if (aadhaar.Length >= 8)
            return "XXXX XXXX " + aadhaar[^4..];
        return aadhaar;
    }

    private static string EmptyText() => "Not specified";

    private static RenderFragment RequiredStar() => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style", "color: #ef4444; margin-left: 2px;");
        builder.AddContent(2, "*");
        builder.CloseElement();
    };

    private record FieldInfo(string Key, string Label, string? Value, bool Editable = true);

    private List<FieldInfo> GetEmploymentFields()
    {
        return new List<FieldInfo>
        {
            new("Designation", "Designation", employee?.Designation),
            new("Department", "Department", employee?.Department),
            new("Company", "Company", employee?.Company),
            new("EmployementType", "Employment Type", employee?.EmployementType),
            new("DOJ", "Date of Joining", employee?.DOJ?.ToString("yyyy-MM-dd")),
            new("Status", "Status", employee?.Status),
            new("Grade", "Grade", employee?.Grade),
            new("Team", "Team", employee?.Team),
            new("Location", "Location", employee?.Location),
            new("SubDepartment", "Sub Department", employee?.SubDepartment),
            new("Division", "Division", employee?.Division),
        };
    }

    private List<FieldInfo> GetFamilyFields()
    {
        return new List<FieldInfo>
        {
            new("FatherName", "Father's Name", employee?.FatherName),
            new("MotherName", "Mother's Name", employee?.MotherName),
            new("Nomenee1", "Nominee 1", employee?.Nomenee1),
