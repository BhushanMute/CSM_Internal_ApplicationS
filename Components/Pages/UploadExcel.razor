@code {
    // Dropdown data
    private List<CompanyDropdown> companies = new();
    private List<DepartmentDropdown> departments = new();
    private int selectedCompanyId = 0;
    private int selectedDepartmentId = 0;
    private bool showValidation = false;

    // File upload state
    private string selectedFileName = string.Empty;
    private long selectedFileSize = 0;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isUploading = false;
    private bool isImporting = false;
    private bool isDragging = false;
    private string previewFilter = "all";
    private ExcelUploadResult? uploadResult;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    private async Task LoadCompanies()
    {
        try
        {
            var result = await EmployeeRepository.GetCompaniesDropdownAsync();
            companies = result.ToList();
            Logger.LogInformation("Loaded {Count} companies", companies.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading companies");
            errorMessage = "Error loading companies. Please refresh the page.";
        }
    }

    private async Task OnCompanyChanged()
    {
        selectedDepartmentId = 0;
        departments.Clear();

        if (selectedCompanyId > 0)
        {
            await LoadDepartments();
        }

        // Clear file if company changes
        if (uploadResult != null)
        {
            ClearFile();
        }
    }

    private async Task LoadDepartments()
    {
        try
        {
            var result = await EmployeeRepository.GetDepartmentsDropdownAsync(selectedCompanyId);
            departments = result.ToList();
            Logger.LogInformation("Loaded {Count} departments for company {CompanyId}", departments.Count, selectedCompanyId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading departments for company {CompanyId}", selectedCompanyId);
            errorMessage = "Error loading departments. Please try again.";
        }
    }

    private void HandleDragEnter() => isDragging = true;
    private void HandleDragLeave() => isDragging = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        // Validate dropdown selections first
        showValidation = true;
        if (selectedCompanyId == 0 || selectedDepartmentId == 0)
        {
            errorMessage = "Please select both Company and Department before uploading a file.";
            return;
        }

        isDragging = false;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        uploadResult = null;
        previewFilter = "all";

        var file = e.File;
        if (file == null) return;

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension != ".xlsx" && extension != ".xls")
        {
            errorMessage = "Invalid file format. Please select an Excel file (.xlsx or .xls)";
            return;
        }

        if (file.Size > 10 * 1024 * 1024)
        {
            errorMessage = $"File size ({FormatFileSize(file.Size)}) exceeds the 10MB limit";
            return;
        }

        selectedFile = file;
        selectedFileName = file.Name;
        selectedFileSize = file.Size;
        isUploading = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Processing file: {FileName}, Size: {Size}, Company: {CompanyId}, Department: {DepartmentId}",
                file.Name, file.Size, selectedCompanyId, selectedDepartmentId);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            uploadResult = await ExcelService.ParseExcelFileAsync(memoryStream, file.Name);

            if (!uploadResult.Success)
            {
                errorMessage = uploadResult.Message;
                if (uploadResult.Errors.Any())
                    errorMessage += ": " + string.Join(", ", uploadResult.Errors);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing file: {FileName}", file.Name);
            errorMessage = $"Error processing file: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task ImportData()
    {
        if (uploadResult == null || !uploadResult.Records.Any()) return;

        // Final validation
        if (selectedCompanyId == 0 || selectedDepartmentId == 0)
        {
            errorMessage = "Please select both Company and Department before importing.";
            showValidation = true;
            return;
        }

        isImporting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Starting import - New: {New}, Update: {Update}, Company: {CompanyId}, Department: {DepartmentId}",
                uploadResult.NewRows, uploadResult.UpdateRows, selectedCompanyId, selectedDepartmentId);

            var result = await ExcelService.ImportEmployeesAsync(
                uploadResult.Records,
                selectedCompanyId,
                selectedDepartmentId);

            if (result.Success)
            {
                var companyName = companies.FirstOrDefault(c => c.CompanyId == selectedCompanyId)?.CompanyName ?? "Unknown";
                var deptName = departments.FirstOrDefault(d => d.DepartmentId == selectedDepartmentId)?.DepartmentName ?? "Unknown";

                successMessage = $"{result.Message} | Company: {companyName}, Department: {deptName}";
                uploadResult = null;
                selectedFileName = string.Empty;
                selectedFileSize = 0;
                selectedFile = null;
            }
            else
            {
                errorMessage = result.Message;
                if (result.Errors.Any())
                    errorMessage += ": " + string.Join(", ", result.Errors);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importing data");
            errorMessage = $"Error importing data: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    private void ClearFile()
    {
        selectedFileName = string.Empty;
        selectedFileSize = 0;
        selectedFile = null;
        uploadResult = null;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        previewFilter = "all";
        showValidation = false;
    }

    private async Task DownloadTemplate()
    {
        try
        {
            var templateBytes = ExcelService.GenerateSampleTemplate();
            var fileName = $"EmployeeTemplate_{DateTime.Now:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, templateBytes);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating template");
            errorMessage = "Error generating template. Please try again.";
        }
    }

    private void SetPreviewFilter(string filter)
    {
        previewFilter = filter;
    }

    private IEnumerable<EmployeeImportDto> GetFilteredRecords()
    {
        if (uploadResult == null) return Enumerable.Empty<EmployeeImportDto>();

        return previewFilter switch
        {
            "new" => uploadResult.Records.Where(r => r.IsValid && !r.IsUpdate && !r.IsDuplicate),
            "update" => uploadResult.Records.Where(r => r.IsValid && r.IsUpdate && !r.IsDuplicate),
            "invalid" => uploadResult.Records.Where(r => !r.IsValid && !r.IsDuplicate),
            "duplicate" => uploadResult.Records.Where(r => r.IsDuplicate),
            _ => uploadResult.Records
        };
    }

    private string GetRowClass(EmployeeImportDto record)
    {
        if (record.IsDuplicate) return "table-warning";
        if (!record.IsValid) return "table-danger";
        if (record.IsUpdate) return "table-info";
        return "";
    }

    private string GetGenderBadgeClass(string? gender) => gender?.ToLower() switch
    {
        "male" => "bg-info",
        "female" => "bg-pink",
        "m" => "bg-info",
        "f" => "bg-pink",
        _ => "bg-secondary"
    };

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private string? TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return null;
        return text.Length <= maxLength ? text : text.Substring(0, maxLength - 3) + "...";
    }
}