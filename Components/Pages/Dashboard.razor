@code {
    private int totalEmployees = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
             
            Logger.LogInformation("Loading dashboard data for user: {User}",
               AuthService.CurrentUser?.LoginName ?? "Unknown");

            totalEmployees = await EmployeeRepository.GetTotalCountAsync();
            Logger.LogInformation("Dashboard loaded successfully. Total employees: {Count}", totalEmployees);

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dashboard data");
        }
        finally
        {
            isLoading = false;
        }
    }
    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12)
            return "Good Morning";
        else if (hour < 18)
            return "Good Afternoon";
        else
            return "Good Evening";
    }
}