@page "/employees"
@using CSMTutorial.Models
@using CSMTutorial.Data.Repositories
@using CSMTutorial.Services

@inject IEmployeeRepository EmployeeRepository
@inject IExcelService ExcelService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<EmployeeList> Logger

<PageTitle>Employees</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3">
                <i class="bi bi-people me-2"></i>Employee Management
            </h1>
            <p class="text-muted">View, search, filter and export employee data</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="ExportToExcel" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel me-1"></i>
                }
                Export
            </button>
            <a href="/upload" class="btn btn-primary">
                <i class="bi bi-upload me-1"></i>Upload Excel
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Employees</h6>
                            <h3 class="mb-0">@totalCount</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-people text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Companies</h6>
                            <h3 class="mb-0">@companies.Count</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-building text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Departments</h6>
                            <h3 class="mb-0">@allDepartments.Count</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-diagram-3 text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Filtered Results</h6>
                            <h3 class="mb-0">@filteredCount</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-funnel text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-funnel me-2"></i>Filters
                </h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">
                    <i class="bi bi-x-circle me-1"></i>Clear All
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Search -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search me-1"></i>Search
                    </label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search by name, code, contact, email..."
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @bind:after="OnSearchChanged" />
                </div>
                
                <!-- Company Filter -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-building me-1"></i>Company
                    </label>
                    <select class="form-select" @bind="selectedCompanyId" @bind:after="OnCompanyFilterChanged">
                        <option value="0">All Companies</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.CompanyId">@company.CompanyName</option>
                        }
                    </select>
                </div>
                
                <!-- Department Filter -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-diagram-3 me-1"></i>Department
                    </label>
                    <select class="form-select" @bind="selectedDepartmentId" @bind:after="LoadEmployees">
                        <option value="0">All Departments</option>
                        @foreach (var dept in filteredDepartments)
                        {
                            <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                        }
                    </select>
                </div>
                
                <!-- Gender Filter -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-gender-ambiguous me-1"></i>Gender
                    </label>
                    <select class="form-select" @bind="selectedGender" @bind:after="LoadEmployees">
                        <option value="">All</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                
                <!-- Status Filter -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-toggle-on me-1"></i>Status
                    </label>
                    <select class="form-select" @bind="selectedStatus" @bind:after="LoadEmployees">
                        <option value="">All</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Resigned">Resigned</option>
                    </select>
                </div>
            </div>
            
            <!-- Active Filters Display -->
            @if (HasActiveFilters())
            {
                <div class="mt-3 pt-3 border-top">
                    <span class="text-muted me-2">Active Filters:</span>
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <span class="badge bg-primary me-2">
                            Search: @searchTerm
                            <button class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" 
                                    @onclick="@(() => { searchTerm = string.Empty; _ = LoadEmployees(); })"></button>
                        </span>
                    }
                    @if (selectedCompanyId > 0)
                    {
                        <span class="badge bg-success me-2">
                            Company: @companies.FirstOrDefault(c => c.CompanyId == selectedCompanyId)?.CompanyName
                            <button class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" 
                                    @onclick="@(() => { selectedCompanyId = 0; _ = OnCompanyFilterChanged(); })"></button>
                        </span>
                    }
                    @if (selectedDepartmentId > 0)
                    {
                        <span class="badge bg-info me-2">
                            Department: @filteredDepartments.FirstOrDefault(d => d.DepartmentId == selectedDepartmentId)?.DepartmentName
                            <button class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" 
                                    @onclick="@(() => { selectedDepartmentId = 0; _ = LoadEmployees(); })"></button>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(selectedGender))
                    {
                        <span class="badge bg-warning text-dark me-2">
                            Gender: @selectedGender
                            <button class="btn-close ms-1" style="font-size: 0.5rem;" 
                                    @onclick="@(() => { selectedGender = string.Empty; _ = LoadEmployees(); })"></button>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(selectedStatus))
                    {
                        <span class="badge bg-secondary me-2">
                            Status: @selectedStatus
                            <button class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" 
                                    @onclick="@(() => { selectedStatus = string.Empty; _ = LoadEmployees(); })"></button>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Employee Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-table me-2"></i>Employee List
                    <span class="badge bg-primary ms-2">@filteredCount</span>
                </h5>
                <div class="d-flex gap-2 align-items-center">
                    <label class="me-2">Show:</label>
                    <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="LoadEmployees">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading employees...</p>
                </div>
            }
            else if (!employees.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <h5 class="mt-3 text-muted">No Employees Found</h5>
                    <p class="text-muted">
                        @if (HasActiveFilters())
                        {
                            <span>No employees match your current filters. <a href="javascript:void(0)" @onclick="ClearFilters">Clear filters</a></span>
                        }
                        else
                        {
                            <span>Upload an Excel file to add employees.</span>
                        }
                    </p>
                    <a href="/upload" class="btn btn-primary mt-2">
                        <i class="bi bi-upload me-1"></i>Upload Excel
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">
                                    <input type="checkbox" class="form-check-input" 
                                           @bind="selectAll" 
                                           @bind:after="ToggleSelectAll" />
                                </th>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Company</th>
                                <th>Department</th>
                                <th>Gender</th>
                                <th>Contact</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in employees)
                            {
                                <tr class="@(selectedEmployees.Contains(emp.EmployeeCode) ? "table-active" : "")">
                                    <td>
                                        <input type="checkbox" class="form-check-input" 
                                               checked="@selectedEmployees.Contains(emp.EmployeeCode)"
                                               @onchange="@(() => ToggleEmployeeSelection(emp.EmployeeCode))" />
                                    </td>
                                    <td>
                                        <code class="text-primary">@emp.EmployeeCode</code>
                                    </td>
                                    <td>
                                        <strong>@emp.EmployeeName</strong>
                                        @if (!string.IsNullOrEmpty(emp.Designation))
                                        {
                                            <small class="text-muted d-block">@emp.Designation</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-building me-1"></i>@(emp.CompanyName ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info">
                                            <i class="bi bi-diagram-3 me-1"></i>@(emp.DepartmentName ?? "N/A")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetGenderBadgeClass(emp.Gender)">
                                            @emp.Gender
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(emp.ContactNo))
                                        {
                                            <a href="tel:@emp.ContactNo" class="text-decoration-none">
                                                <i class="bi bi-telephone me-1"></i>@emp.ContactNo
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(emp.Email))
                                        {
                                            <a href="mailto:@emp.Email" class="text-decoration-none" title="@emp.Email">
                                                <i class="bi bi-envelope me-1"></i>@TruncateText(emp.Email, 20)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(emp.Status)">
                                            @(emp.Status ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" 
                                                    title="View Details"
                                                    @onclick="@(() => ShowEmployeeDetails(emp))">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <a href="/employee/@emp.EmployeeCode" 
                                               class="btn btn-outline-secondary" 
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button class="btn btn-outline-danger" 
                                                    title="Delete"
                                                    @onclick="@(() => ConfirmDelete(emp))">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        
        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">
                        Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, filteredCount) of @filteredCount entries
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="@(() => GoToPage(1))">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="@(() => GoToPage(currentPage - 1))">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>

                            @foreach (var pageNumber in GetVisiblePages())
                            {
                                <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="@(() => GoToPage(pageNumber))">
                                        @pageNumber
                                    </button>
                                </li>
                            }
                            
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="@(() => GoToPage(currentPage + 1))">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="@(() => GoToPage(totalPages))">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<!-- Employee Details Modal -->
@if (showDetailsModal && selectedEmployee != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-badge me-2"></i>Employee Details
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">Basic Information</h6>
                            <table class="table table-sm table-borderless">
                                <tr><th width="40%">Code:</th><td><code>@selectedEmployee.EmployeeCode</code></td></tr>
                                <tr><th>Name:</th><td><strong>@selectedEmployee.EmployeeName</strong></td></tr>
                                <tr><th>Gender:</th><td><span class="badge @GetGenderBadgeClass(selectedEmployee.Gender)">@selectedEmployee.Gender</span></td></tr>
                                <tr><th>Contact:</th><td>@(selectedEmployee.ContactNo ?? "-")</td></tr>
                                <tr><th>Email:</th><td>@(selectedEmployee.Email ?? "-")</td></tr>
                                <tr><th>Location:</th><td>@(selectedEmployee.Location ?? "-")</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">Work Information</h6>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <th width="40%">Company:</th>
                                    <td><span class="badge bg-success">@(selectedEmployee.CompanyName ?? "-")</span></td>
                                </tr>
                                <tr>
                                    <th>Department:</th>
                                    <td><span class="badge bg-info">@(selectedEmployee.DepartmentName ?? "-")</span></td>
                                </tr>
                                <tr><th>Designation:</th><td>@(selectedEmployee.Designation ?? "-")</td></tr>
                                <tr><th>Status:</th><td><span class="badge @GetStatusBadgeClass(selectedEmployee.Status)">@(selectedEmployee.Status ?? "-")</span></td></tr>
                                <tr><th>DOJ:</th><td>@(selectedEmployee.DOJ?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                                <tr><th>DOB:</th><td>@(selectedEmployee.DOB?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                            </table>
                        </div>
                        <div class="col-12">
                            <h6 class="text-muted mb-3">Additional Details</h6>
                            <table class="table table-sm table-borderless">
                                <tr><th width="20%">Aadhaar:</th><td>@(selectedEmployee.AadhaarNumber ?? "-")</td></tr>
                                <tr><th>Father's Name:</th><td>@(selectedEmployee.FatherName ?? "-")</td></tr>
                                <tr><th>Mother's Name:</th><td>@(selectedEmployee.MotherName ?? "-")</td></tr>
                                <tr><th>Blood Group:</th><td>@(selectedEmployee.BloodGroup ?? "-")</td></tr>
                                <tr><th>Address:</th><td>@(selectedEmployee.ResidentialAddress ?? "-")</td></tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModals">Close</button>
                    <a href="/employee/@selectedEmployee.EmployeeCode" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && employeeToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this employee?</p>
                    <div class="alert alert-light">
                        <strong>@employeeToDelete.EmployeeName</strong> (@employeeToDelete.EmployeeCode)
                    </div>
                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteEmployee" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }
    .bg-info-subtle {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }
    .bg-pink {
        background-color: #e83e8c !important;
        color: white;
    }
    .table th {
        font-weight: 600;
        white-space: nowrap;
    }
    .badge {
        font-weight: 500;
    }
</style>

@code {
    // Filter dropdowns data
    private List<CompanyDropdown> companies = new();
    private List<DepartmentDropdown> allDepartments = new();
    private List<DepartmentDropdown> filteredDepartments = new();
    
    // Filter values
    private int selectedCompanyId = 0;
    private int selectedDepartmentId = 0;
    private string selectedGender = string.Empty;
    private string selectedStatus = string.Empty;
    private string searchTerm = string.Empty;
    
    // Employee data
    private List<Employee> employees = new();
    private int totalCount = 0;
    private int filteredCount = 0;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)filteredCount / pageSize);
    
    // UI state
    private bool isLoading = true;
    private bool isExporting = false;
    private bool isDeleting = false;
    private bool selectAll = false;
    private HashSet<string> selectedEmployees = new();
    
    // Modals
    private bool showDetailsModal = false;
    private bool showDeleteModal = false;
    private Employee? selectedEmployee;
    private Employee? employeeToDelete;
    
    // Search debounce
    private System.Timers.Timer? searchDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadEmployees();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            companies = (await EmployeeRepository.GetCompaniesDropdownAsync()).ToList();
            allDepartments = (await EmployeeRepository.GetDepartmentsDropdownAsync()).ToList();
            filteredDepartments = allDepartments;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dropdowns");
        }
    }

    private async Task OnCompanyFilterChanged()
    {
        selectedDepartmentId = 0;
        
        if (selectedCompanyId > 0)
        {
            // Filter departments by company if you have company-department mapping
            // For now, show all departments
            filteredDepartments = allDepartments;
        }
        else
        {
            filteredDepartments = allDepartments;
        }
        
        await LoadEmployees();
    }

    private void OnSearchChanged()
    {
        // Debounce search
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
        
        searchDebounceTimer = new System.Timers.Timer(300);
        searchDebounceTimer.Elapsed += async (s, e) =>
        {
            searchDebounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadEmployees();
                StateHasChanged();
            });
        };
        searchDebounceTimer.AutoReset = false;
        searchDebounceTimer.Start();
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Loading employees - Page: {Page}, Size: {Size}, Search: {Search}, Company: {Company}, Dept: {Dept}",
                currentPage, pageSize, searchTerm, selectedCompanyId, selectedDepartmentId);

            employees = (await EmployeeRepository.GetAllAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                searchTerm: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                companyId: selectedCompanyId > 0 ? selectedCompanyId : null,
                departmentId: selectedDepartmentId > 0 ? selectedDepartmentId : null,
                gender: string.IsNullOrWhiteSpace(selectedGender) ? null : selectedGender,
                status: string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus
            )).ToList();

            Logger.LogInformation("Loaded {Count} employees", employees.Count);

            filteredCount = await EmployeeRepository.GetTotalCountAsync(
                searchTerm: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                companyId: selectedCompanyId > 0 ? selectedCompanyId : null,
                departmentId: selectedDepartmentId > 0 ? selectedDepartmentId : null,
                gender: string.IsNullOrWhiteSpace(selectedGender) ? null : selectedGender,
                status: string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus
            );

            Logger.LogInformation("Total filtered count: {Count}", filteredCount);

            totalCount = await EmployeeRepository.GetTotalCountAsync();

            selectAll = false;
            selectedEmployees.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employees: {Message}", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        selectedCompanyId = 0;
        selectedDepartmentId = 0;
        selectedGender = string.Empty;
        selectedStatus = string.Empty;
        filteredDepartments = allDepartments;
        currentPage = 1;
        await LoadEmployees();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(searchTerm) ||
               selectedCompanyId > 0 ||
               selectedDepartmentId > 0 ||
               !string.IsNullOrWhiteSpace(selectedGender) ||
               !string.IsNullOrWhiteSpace(selectedStatus);
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        await LoadEmployees();
    }

    private IEnumerable<int> GetVisiblePages()
    {
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, currentPage + 2);
        return Enumerable.Range(start, end - start + 1);
    }

    private void ToggleSelectAll()
    {
        if (selectAll)
            selectedEmployees = employees.Select(e => e.EmployeeCode).ToHashSet();
        else
            selectedEmployees.Clear();
    }

    private void ToggleEmployeeSelection(string code)
    {
        if (selectedEmployees.Contains(code))
            selectedEmployees.Remove(code);
        else
            selectedEmployees.Add(code);
        
        selectAll = selectedEmployees.Count == employees.Count;
    }

    private void ShowEmployeeDetails(Employee emp)
    {
        selectedEmployee = emp;
        showDetailsModal = true;
    }

    private void ConfirmDelete(Employee emp)
    {
        employeeToDelete = emp;
        showDeleteModal = true;
    }

    private void CloseModals()
    {
        showDetailsModal = false;
        showDeleteModal = false;
        selectedEmployee = null;
        employeeToDelete = null;
    }

    private async Task DeleteEmployee()
    {
        if (employeeToDelete == null) return;
        
        isDeleting = true;
        try
        {
            await EmployeeRepository.DeleteAsync(employeeToDelete.EmployeeCode);
            CloseModals();
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting employee {Code}", employeeToDelete.EmployeeCode);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task ExportToExcel()
    {
        isExporting = true;
        StateHasChanged();
        
        try
        {
            var exportData = await EmployeeRepository.GetForExportAsync(
                companyId: selectedCompanyId > 0 ? selectedCompanyId : null,
                departmentId: selectedDepartmentId > 0 ? selectedDepartmentId : null,
                status: string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus
            );
            
            var excelBytes = ExcelService.ExportEmployeesToExcel(exportData);
            var fileName = $"Employees_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, excelBytes);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting employees");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private string GetGenderBadgeClass(string? gender) => gender?.ToLower() switch
    {
        "male" => "bg-info",
        "female" => "bg-pink",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(string? status) => status?.ToLower() switch
    {
        "active" => "bg-success",
        "inactive" => "bg-warning text-dark",
        "resigned" => "bg-danger",
        _ => "bg-secondary"
    };

    private string? TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return null;
        return text.Length <= maxLength ? text : text[..(maxLength - 3)] + "...";
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
    }
}