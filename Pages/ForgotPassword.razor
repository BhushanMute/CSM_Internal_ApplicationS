@page "/forgot-password"
@using CSMTutorial.Models
@using CSMTutorial.Services
@using CSMTutorial.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@layout LoginLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot Password - CSM Tutorial</PageTitle>

<div class="auth-page-container">
    <div class="auth-card">

        @if (isSuccess)
        {
            <!-- Success View -->
            <div class="success-view text-center py-4">
                <div class="icon-circle mb-4 mx-auto success-pulse">
                    <i class="bi bi-envelope-check-fill text-success display-5"></i>
                </div>
                <h3 class="fw-bold text-dark mb-3">Check your email</h3>
                <p class="text-muted mb-4 px-3">
                    If an account exists for <strong>@model.Email</strong>, we have sent a password reset link. Please check your spam folder if you don't see it.
                </p>

                <a href="/login" class="btn btn-primary custom-btn w-100 py-3 d-flex justify-content-center align-items-center gap-2">
                    <i class="bi bi-arrow-left fs-5"></i>
                    <span>Back to Login</span>
                </a>
            </div>
        }
        else
        {
            <!-- Form View -->
            <div class="auth-header text-center mb-5">
                <div class="icon-circle mb-4 mx-auto">
                    <i class="bi bi-shield-lock-fill text-primary display-5"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Forgot Password?</h2>
                <p class="text-muted">No worries, we'll send you reset instructions.</p>
            </div>

            <!-- Error Toast -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-modern alert-danger d-flex align-items-center toast-top-right shadow" role="alert">
                    <div class="alert-icon-wrapper danger-bg me-3" style="width: 32px; height: 32px;">
                        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                    </div>
                    <div class="text-danger-emphasis fw-medium" style="font-size: 0.85rem;">@errorMessage</div>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />

                <div class="form-floating mb-4 position-relative">
                    <i class="bi bi-envelope input-icon"></i>
                    <InputText id="email" type="email" class="form-control custom-input ps-5"
                               @bind-Value="model.Email" placeholder="Enter your registered email" disabled="@isLoading" />
                    <label for="email" class="ms-4 text-muted">Email Address</label>
                    <ValidationMessage For="@(() => model.Email)" class="text-danger small mt-2 fw-medium px-2" />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-4 custom-btn d-flex justify-content-center align-items-center gap-2" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Sending Link...</span>
                    }
                    else
                    {
                        <span>Reset Password</span>
                        <i class="bi bi-arrow-right fs-5"></i>
                    }
                </button>
            </EditForm>

            <!-- Footer Link -->
            <div class="text-center mt-2 border-top pt-4">
                <a href="/login" class="text-muted fw-medium text-decoration-none hover-opacity d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </div>
        }
    </div>
</div>

<style>
    /* Main Layout */
    .auth-page-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f3f8ff 0%, #e2eafc 100%);
        padding: 2rem 1rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* Card Styling */
    .auth-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 3.5rem 3rem;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 20px 40px rgba(18, 38, 63, 0.08), 0 1px 3px rgba(18, 38, 63, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUpFade {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Header & Icons */
    .icon-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.15);
        position: relative;
    }

        .icon-circle::after {
            content: '';
            position: absolute;
            inset: -6px;
            border-radius: 50%;
            border: 2px dashed rgba(13, 110, 253, 0.2);
        }

    /* Success State Overrides */
    .success-view {
        animation: fadeIn 0.5s ease-out;
    }

    .success-pulse {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.2);
    }

        .success-pulse::after {
            border-color: rgba(16, 185, 129, 0.3);
        }

    /* Input Fields */
    .custom-input {
        border-radius: 16px;
        border: 2px solid #eef2f6;
        background-color: #f8fafc;
        height: calc(3.8rem + 2px);
        font-size: 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            background-color: #ffffff;
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
        }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 1.25rem;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1.25rem;
        z-index: 4;
        transition: color 0.3s ease;
    }

    .custom-input:focus ~ .input-icon,
    .custom-input:focus ~ label {
        color: #0d6efd !important;
    }

    .form-floating > label {
        padding: 1.15rem 0.75rem;
        font-weight: 500;
    }

    /* Buttons */
    .custom-btn {
        border-radius: 16px;
        font-weight: 600;
        letter-spacing: 0.5px;
        border: none;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25);
        transition: all 0.3s ease;
    }

        .custom-btn:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(13, 110, 253, 0.35);
            background: linear-gradient(135deg, #0b5ed7 0%, #084298 100%);
        }

    /* Toast Notifications */
    .toast-top-right {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 1050;
        min-width: 250px;
        max-width: 350px;
        margin-bottom: 0 !important;
        padding: 0.75rem 1rem;
        border: none;
        border-radius: 16px;
        background-color: #f8fafc;
        animation: slideInRight 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes slideInRight {
        from

    {
        transform: translateX(120%);
        opacity: 0;
    }

    to {
        transform: translateX(0);
        opacity: 1;
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: scale(0.95);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    .alert-icon-wrapper {
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .danger-bg {
        background-color: #fee2e2;
    }

    /* Utilities */
    .hover-opacity {
        transition: opacity 0.2s ease;
    }

        .hover-opacity:hover {
            opacity: 0.7;
            color: #0d6efd !important;
        }

    ::deep .validation-message {
        display: none;
    }
    /* Use custom span for validation text */

    @@media (max-width: 576px) {
        .auth-card

    {
        padding: 2.5rem 1.5rem;
        border-radius: 20px;
    }

    }
</style>

@code {
    private ForgotPasswordModel model = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isSuccess = false;

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(model.Email);

            if (result.Success)
            {
                isSuccess = true;
                Logger.LogInformation("Password reset email requested for: {Email}", model.Email);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during forgot password");
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}