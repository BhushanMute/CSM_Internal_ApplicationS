@code {
    // ==========================================
    // STATE VARIABLES
    // ==========================================
    private List<CompanyDropdown> companies = new();
    private List<DepartmentDropdown> departments = new();
    private List<EmployeeListItem> employeeList = new();

    private int selectedCompanyId = 0;
    private int selectedDepartmentId = 0;
    private string searchTerm = string.Empty;
    private string selectedStatus = string.Empty;

    private int currentPage = 1;
    private int pageSize = 20;
    private int employeeCount = 0;
    private int totalPages => (int)Math.Ceiling((double)employeeCount / pageSize);

    private bool isLoading = false;
    private string viewMode = "table"; // "table" or "grid"

    private System.Timers.Timer? searchTimer;

    // Computed property
    private bool HasActiveFilters => selectedCompanyId > 0 ||
                                     selectedDepartmentId > 0 ||
                                     !string.IsNullOrEmpty(searchTerm) ||
                                     !string.IsNullOrEmpty(selectedStatus);

    // ==========================================
    // LIFECYCLE METHODS
    // ==========================================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            companies = (await EmployeeRepository.GetCompaniesDropdownAsync()).ToList();
            Logger.LogInformation("Loaded {Count} companies", companies.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading companies");
        }
    }

    public void Dispose()
    {
        searchTimer?.Stop();
        searchTimer?.Dispose();
    }

    // ==========================================
    // EVENT HANDLERS
    // ==========================================
    private async Task OnCompanyChanged()
    {
        selectedDepartmentId = 0;
        departments.Clear();
        currentPage = 1;

        if (selectedCompanyId > 0)
        {
            try
            {
                departments = (await EmployeeRepository.GetDepartmentsDropdownAsync(selectedCompanyId)).ToList();
                Logger.LogInformation("Loaded {Count} departments for company {CompanyId}",
                    departments.Count, selectedCompanyId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading departments");
            }

            await LoadEmployees();
        }
        else
        {
            employeeList.Clear();
            employeeCount = 0;
        }
    }

    private async Task OnDepartmentChanged()
    {
        currentPage = 1;
        await LoadEmployees();
    }

    private async Task OnStatusChanged()
    {
        currentPage = 1;
        await LoadEmployees();
    }

    private void OnSearchChanged()
    {
        // Debounce search
        searchTimer?.Stop();
        searchTimer?.Dispose();

        searchTimer = new System.Timers.Timer(400);
        searchTimer.Elapsed += async (s, e) =>
        {
            searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadEmployees();
                StateHasChanged();
            });
        };
        searchTimer.AutoReset = false;
        searchTimer.Start();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadEmployees();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        _ = LoadEmployees();
    }

    private async Task ClearAllFilters()
    {
        selectedDepartmentId = 0;
        searchTerm = string.Empty;
        selectedStatus = string.Empty;
        currentPage = 1;
        await LoadEmployees();
    }

    private async Task RefreshData()
    {
        await LoadEmployees();
    }

    // ==========================================
    // DATA LOADING
    // ==========================================
    private async Task LoadEmployees()
    {
        if (selectedCompanyId == 0)
        {
            employeeList.Clear();
            employeeCount = 0;
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // Load employee list
            employeeList = (await AttendanceRepository.GetEmployeesByCompanyDepartmentAsync(
                selectedCompanyId > 0 ? selectedCompanyId : null,
                selectedDepartmentId > 0 ? selectedDepartmentId : null,
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                currentPage,
                pageSize
            )).ToList();

            // Load total count
            employeeCount = await AttendanceRepository.GetEmployeesCountByCompanyDepartmentAsync(
                selectedCompanyId > 0 ? selectedCompanyId : null,
                selectedDepartmentId > 0 ? selectedDepartmentId : null,
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm
            );

            Logger.LogInformation(
                "Loaded {Count} employees (Total: {Total}) for Company: {CompanyId}, Dept: {DeptId}",
                employeeList.Count, employeeCount, selectedCompanyId, selectedDepartmentId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employees");
            employeeList = new();
            employeeCount = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ==========================================
    // NAVIGATION
    // ==========================================
    private void ViewEmployeeAttendance(int employeeId)
    {
        Navigation.NavigateTo($"/attendance/employee/{employeeId}");
    }

    // ==========================================
    // PAGINATION
    // ==========================================
    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        await LoadEmployees();
    }

    private IEnumerable<int> GetVisiblePages()
    {
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, currentPage + 2);

        // Ensure we always show at least 5 pages if available
        if (end - start < 4)
        {
            if (start == 1)
                end = Math.Min(totalPages, start + 4);
            else if (end == totalPages)
                start = Math.Max(1, end - 4);
        }

        return Enumerable.Range(start, end - start + 1);
    }

    // ==========================================
    // HELPER METHODS
    // ==========================================
    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }

        return name.Length >= 2
            ? name[..2].ToUpper()
            : name.ToUpper();
    }

    private string GetAvatarColor(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "color-1";

        // Generate consistent color based on name
        int hash = name.GetHashCode();
        int colorIndex = Math.Abs(hash % 5) + 1;
        return $"color-{colorIndex}";
    }
}