@code {
    // Filter state
    private DateTime selectedDate = DateTime.Today;
    private int selectedCompanyId = 0;
    private int selectedDepartmentId = 0;
    private string selectedStatus = string.Empty;
    private string searchTerm = string.Empty;
    private string selectedDeviceLogTable = string.Empty;

    // Data
    private List<DailyAttendanceRecord> attendanceRecords = new();
    private List<DeviceLogRecord> deviceLogs = new();
    private List<PunchDetail> punchDetails = new();
    private AttendanceSummary? summary;
    private List<DeviceLogTableInfo> availableLogTables = new();
    private List<CompanyDropdown> companies = new();
    private List<DepartmentDropdown> departments = new();

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount = 0;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    // UI state
    private bool isLoading = true;
    private bool isLoadingDeviceLogs = false;
    private bool isLoadingPunchDetails = false;
    private bool isExporting = false;
    private string activeTab = "attendance";
    private string activeDeviceLogTable = string.Empty;

    // Modal
    private bool showPunchModal = false;
    private DailyAttendanceRecord? selectedAttendance;

    // Debounce
    private System.Timers.Timer? searchTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadAvailableLogTables();
        await LoadData();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            companies = (await EmployeeRepository.GetCompaniesDropdownAsync()).ToList();
            departments = (await EmployeeRepository.GetDepartmentsDropdownAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dropdowns");
        }
    }

    private async Task LoadAvailableLogTables()
    {
        try
        {
            availableLogTables = (await AttendanceRepository.GetAvailableDeviceLogTablesAsync()).ToList();
            Logger.LogInformation("Found {Count} device log tables", availableLogTables.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading available log tables");
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Update active device log table name
            UpdateActiveDeviceLogTable();

            // Load attendance records
            attendanceRecords = (await AttendanceRepository.GetDailyAttendanceAsync(
                selectedDate,
                selectedCompanyId > 0 ? selectedCompanyId : null,
                selectedDepartmentId > 0 ? selectedDepartmentId : null,
                string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus,
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                currentPage,
                pageSize
            )).ToList();

            // Load count
            totalCount = await AttendanceRepository.GetDailyAttendanceCountAsync(
                selectedDate,
                selectedCompanyId > 0 ? selectedCompanyId : null,
                selectedDepartmentId > 0 ? selectedDepartmentId : null,
                string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus,
                string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm
            );

            // Load summary
            summary = await AttendanceRepository.GetAttendanceSummaryAsync(
                selectedDate,
                selectedCompanyId > 0 ? selectedCompanyId : null,
                selectedDepartmentId > 0 ? selectedDepartmentId : null
            );

            Logger.LogInformation("Loaded {Count} attendance records for {Date}", attendanceRecords.Count, selectedDate);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading attendance data for {Date}", selectedDate);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDeviceLogs()
    {
        isLoadingDeviceLogs = true;
        StateHasChanged();

        try
        {
            int month = selectedDate.Month;
            int year = selectedDate.Year;

            // If specific table selected, extract month/year from it
            if (!string.IsNullOrEmpty(selectedDeviceLogTable))
            {
                var parts = selectedDeviceLogTable.Replace("DeviceLogs_", "").Split('_');
                if (parts.Length == 2)
                {
                    int.TryParse(parts[0], out month);
                    int.TryParse(parts[1], out year);
                }
            }

            deviceLogs = (await AttendanceRepository.GetDeviceLogsAsync(
                month,
                year,
                selectedDate,
                null,
                selectedCompanyId > 0 ? selectedCompanyId : null,
                selectedDepartmentId > 0 ? selectedDepartmentId : null
            )).ToList();

            Logger.LogInformation("Loaded {Count} device logs from DeviceLogs_{Month}_{Year}", deviceLogs.Count, month, year);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading device logs");
        }
        finally
        {
            isLoadingDeviceLogs = false;
            StateHasChanged();
        }
    }

    private void UpdateActiveDeviceLogTable()
    {
        if (!string.IsNullOrEmpty(selectedDeviceLogTable))
        {
            activeDeviceLogTable = selectedDeviceLogTable;
        }
        else
        {
            activeDeviceLogTable = $"DeviceLogs_{selectedDate.Month}_{selectedDate.Year}";
        }
    }

    private async Task OnDateChanged()
    {
        currentPage = 1;
        deviceLogs.Clear();
        await LoadData();

        if (activeTab == "devicelogs")
            await LoadDeviceLogs();
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadData();

        if (activeTab == "devicelogs")
            await LoadDeviceLogs();
    }

    private async Task OnDeviceLogTableChanged()
    {
        UpdateActiveDeviceLogTable();

        if (activeTab == "devicelogs")
            await LoadDeviceLogs();
    }

    private void OnSearchChanged()
    {
        searchTimer?.Stop();
        searchTimer?.Dispose();

        searchTimer = new System.Timers.Timer(400);
        searchTimer.Elapsed += async (s, e) =>
        {
            searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadData();
                StateHasChanged();
            });
        };
        searchTimer.AutoReset = false;
        searchTimer.Start();
    }

    private async Task ShowPunchDetails(DailyAttendanceRecord record)
    {
        selectedAttendance = record;
        showPunchModal = true;
        isLoadingPunchDetails = true;
        StateHasChanged();

        try
        {
            punchDetails = (await AttendanceRepository.GetEmployeePunchDetailsAsync(
                record.EmployeeId,
                record.AttendanceDate
            )).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading punch details for employee {Id}", record.EmployeeId);
            punchDetails = new();
        }
        finally
        {
            isLoadingPunchDetails = false;
            StateHasChanged();
        }
    }

    private void ClosePunchModal()
    {
        showPunchModal = false;
        selectedAttendance = null;
        punchDetails.Clear();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        await LoadData();
    }

    private IEnumerable<int> GetVisiblePages()
    {
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, currentPage + 2);
        return Enumerable.Range(start, end - start + 1);
    }

    private async Task ExportReport()
    {
        // TODO: Implement export
        isExporting = true;
        StateHasChanged();
        await Task.Delay(1000);
        isExporting = false;
    }

    private string GetAttendanceRowClass(DailyAttendanceRecord record)
    {
        if (record.Absent > 0) return "table-danger";
        if (record.WeeklyOff == 1) return "table-secondary";
        if (record.Holiday == 1) return "table-info";
        if (record.IsOnLeave == 1) return "table-warning";
        if (record.LateBy > 0) return "";
        return "";
    }

    private string GetStatusBadgeClass(string statusCode) => statusCode?.ToUpper() switch
    {
        "P" => "bg-success",
        "A" => "bg-danger",
        "WO" => "bg-secondary",
        "H" => "bg-info",
        "L" => "bg-warning text-dark",
        "HD" => "bg-warning text-dark",
        "MP" => "bg-dark",
        _ => "bg-secondary"
    };

    private string? TruncateText(string? text, int max)
    {
        if (string.IsNullOrEmpty(text)) return null;
        return text.Length <= max ? text : text[..(max - 3)] + "...";
    }

    public void Dispose()
    {
        searchTimer?.Dispose();
    }
}