@page "/attendance/employee/{EmployeeId:int}"
@using CSMTutorial.Models
@using CSMTutorial.Data.Repositories
@using CSMTutorial.Services

@inject IAttendanceRepository AttendanceRepository
@inject IEmployeeRepository EmployeeRepository
@inject IExcelService ExcelService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<EmployeeAttendance> Logger

@implements IDisposable

<PageTitle>@(employee?.EmployeeName ?? "Employee") - Attendance | HR Portal</PageTitle>

<div class="employee-attendance-page">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav">
        <button class="back-button" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </button>
        <ol class="breadcrumb-list">
            <li><a href="/attendance">Attendance</a></li>
            <li><i class="bi bi-chevron-right"></i></li>
            <li class="active">Employee Details</li>
        </ol>
    </nav>

    <!-- Hero Profile Section -->
    @if (employee != null)
    {
        <div class="profile-hero">
            <div class="profile-background">
                <div class="bg-pattern"></div>
            </div>
            <div class="profile-content">
                <div class="profile-main">
                    <div class="profile-avatar @GetAvatarColorClass()">
                        <span>@GetInitials(employee.EmployeeName)</span>
                        <div class="avatar-status @(employee.Status == "Active" ? "online" : "offline")"></div>
                    </div>
                    <div class="profile-info">
                        <h1>@employee.EmployeeName</h1>
                        <div class="profile-meta">
                            <span class="meta-item code">
                                <i class="bi bi-fingerprint"></i>
                                @employee.EmployeeCode
                            </span>
                            <span class="meta-divider">•</span>
                            <span class="meta-item">
                                <i class="bi bi-building"></i>
                                @employee.CompanyName
                            </span>
                            <span class="meta-divider">•</span>
                            <span class="meta-item">
                                <i class="bi bi-diagram-3"></i>
                                @employee.DepartmentName
                            </span>
                            @if (!string.IsNullOrEmpty(employee.Designation))
                            {
                                <span class="meta-divider">•</span>
                                <span class="meta-item">
                                    <i class="bi bi-briefcase"></i>
                                    @employee.Designation
                                </span>
                            }
                        </div>
                        <div class="profile-status">
                            <span class="status-badge @(employee.Status == "Active" ? "active" : "inactive")">
                                <span class="status-dot"></span>
                                @employee.Status
                            </span>
                        </div>
                    </div>
                </div>

                <div class="profile-actions">
                    <!-- Month Selector -->
                    <div class="month-selector">
                        <label>
                            <i class="bi bi-calendar3"></i>
                            View Month
                        </label>
                        <div class="month-dropdown">
                            <select @bind="selectedMonthKey" @bind:after="OnMonthChanged">
                                @foreach (var month in availableMonths)
                                {
                                    <option value="@($"{month.AttMonth}_{month.AttYear}")">
                                        @month.DisplayName
                                    </option>
                                }
                                @if (!availableMonths.Any())
                                {
                                    <option value="@($"{DateTime.Now.Month}_{DateTime.Now.Year}")">
                                        @DateTime.Now.ToString("MMMM yyyy")
                                    </option>
                                }
                            </select>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <button class="btn-export" @onclick="ExportToExcel" 
                                disabled="@(isExporting || !attendanceRecords.Any())">
                            @if (isExporting)
                            {
                                <span class="btn-spinner"></span>
                                <span>Exporting...</span>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-excel"></i>
                                <span>Export Excel</span>
                            }
                        </button>
                        <button class="btn-icon" @onclick="PrintReport" 
                                disabled="@(!attendanceRecords.Any())" title="Print Report">
                            <i class="bi bi-printer"></i>
                        </button>
                        <button class="btn-icon" @onclick="RefreshData" 
                                disabled="@isLoading" title="Refresh Data">
                            <i class="bi bi-arrow-clockwise @(isLoading ? "spinning" : "")"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (isLoading)
    {
        <!-- Skeleton Loading -->
        <div class="profile-hero skeleton">
            <div class="skeleton-avatar"></div>
            <div class="skeleton-content">
                <div class="skeleton-line lg"></div>
                <div class="skeleton-line md"></div>
                <div class="skeleton-line sm"></div>
            </div>
        </div>
    }

    <!-- Analytics Dashboard -->
    @if (monthlySummary != null)
    {
        <div class="analytics-section">
            <div class="section-header">
                <h2>
                    <i class="bi bi-graph-up-arrow"></i>
                    Monthly Analytics
                </h2>
                <span class="period-badge">
                    <i class="bi bi-calendar-range"></i>
                    @GetSelectedMonthName()
                </span>
            </div>

            <div class="analytics-grid">
                <!-- Working Days Card -->
                <div class="stat-card working">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-range"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@monthlySummary.TotalDays</span>
                        <span class="stat-label">Working Days</span>
                    </div>
                    <div class="stat-decoration">
                        <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                            <path d="M0,35 Q25,25 50,30 T100,20" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/>
                        </svg>
                    </div>
                </div>

                <!-- Present Days Card -->
                <div class="stat-card present">
                    <div class="stat-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@monthlySummary.PresentDays</span>
                        <span class="stat-label">Days Present</span>
                        <span class="stat-trend positive">
                            <i class="bi bi-arrow-up-short"></i>
                            @monthlySummary.PresentPercentage%
                        </span>
                    </div>
                    <div class="progress-ring">
                        <svg viewBox="0 0 36 36">
                            <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            <path class="ring-progress" 
                                  stroke-dasharray="@monthlySummary.PresentPercentage, 100" 
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                        </svg>
                        <span class="ring-text">@monthlySummary.PresentPercentage%</span>
                    </div>
                </div>

                <!-- Absent Days Card -->
                <div class="stat-card absent">
                    <div class="stat-icon">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@monthlySummary.AbsentDays</span>
                        <span class="stat-label">Days Absent</span>
                        @if (monthlySummary.AbsentDays > 3)
                        {
                            <span class="stat-trend negative">
                                <i class="bi bi-exclamation-triangle"></i>
                                Review Required
                            </span>
                        }
                    </div>
                </div>

                <!-- Late Arrivals Card -->
                <div class="stat-card late">
                    <div class="stat-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@monthlySummary.LateDays</span>
                        <span class="stat-label">Late Arrivals</span>
                        <span class="stat-sub">@monthlySummary.FormattedTotalLate total</span>
                    </div>
                </div>

                <!-- Leave Days Card -->
                <div class="stat-card leave">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@monthlySummary.LeaveDays</span>
                        <span class="stat-label">Leave Days</span>
                    </div>
                </div>

                <!-- Overtime Card -->
                <div class="stat-card overtime">
                    <div class="stat-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value">@monthlySummary.FormattedTotalOT</span>
                        <span class="stat-label">Total Overtime</span>
                        @if (monthlySummary.TotalOvertimeMinutes > 60)
                        {
                            <span class="stat-trend positive">
                                <i class="bi bi-star-fill"></i>
                                Great Effort! (@monthlySummary.FormattedTotalOT)
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Attendance Records Section -->
    <div class="records-section">
        <div class="records-header">
            <div class="header-left">
                <h2>
                    <i class="bi bi-table"></i>
                    Daily Attendance Log
                </h2>
                <span class="record-count">@attendanceRecords.Count records</span>
            </div>
            <div class="header-right">
                <!-- View Toggle -->
                <div class="view-toggle">
                    <button class="@(viewMode == "table" ? "active" : "")" 
                            @onclick="@(() => viewMode = "table")" title="Table View">
                        <i class="bi bi-list-ul"></i>
                    </button>
                    <button class="@(viewMode == "calendar" ? "active" : "")" 
                            @onclick="@(() => viewMode = "calendar")" title="Calendar View">
                        <i class="bi bi-calendar-week"></i>
                    </button>
                </div>
                
                <!-- Legend -->
                <div class="legend">
                    <span class="legend-item present"><span class="dot"></span>Present</span>
                    <span class="legend-item absent"><span class="dot"></span>Absent</span>
                    <span class="legend-item late"><span class="dot"></span>Late</span>
                    <span class="legend-item leave"><span class="dot"></span>Leave</span>
                </div>
            </div>
        </div>

        <div class="records-body">
            @if (isLoading)
            {
                <!-- Loading State -->
                <div class="loading-state">
                    <div class="loader">
                        <div class="loader-ring">
                            <div></div><div></div><div></div><div></div>
                        </div>
                    </div>
                    <p>Loading attendance records...</p>
                </div>
            }
            else if (!attendanceRecords.Any())
            {
                <!-- Empty State -->
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <h3>No Attendance Records</h3>
                    <p>No attendance data found for @GetSelectedMonthName()</p>
                    @if (availableMonths.Count > 1)
                    {
                        <button class="btn-secondary" @onclick="SelectPreviousMonth">
                            <i class="bi bi-arrow-left me-2"></i>
                            View Previous Month
                        </button>
                    }
                </div>
            }
            else if (viewMode == "table")
            {
                <!-- Table View -->
                <div class="table-wrapper">
                    <table class="attendance-table">
                        <thead>
                            <tr>
                                <th class="col-date">Date</th>
                                <th class="col-day">Day</th>
                                <th class="col-shift">Shift</th>
                                <th class="col-time">
                                    <i class="bi bi-box-arrow-in-right"></i> In
                                </th>
                                <th class="col-time">
                                    <i class="bi bi-box-arrow-right"></i> Out
                                </th>
                                <th class="col-duration">Duration</th>
                                <th class="col-variance">Late</th>
                                <th class="col-variance">Early</th>
                                <th class="col-variance">OT</th>
                                <th class="col-status">Status</th>
                                <th class="col-punches">Punches</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in attendanceRecords)
                            {
                                var isWeekend = record.AttendanceDate.DayOfWeek == DayOfWeek.Sunday || 
                                               record.AttendanceDate.DayOfWeek == DayOfWeek.Saturday;
                                var isSunday = record.AttendanceDate.DayOfWeek == DayOfWeek.Sunday;
                                
                                <tr class="@GetRowClass(record) @(isWeekend ? "weekend-row" : "")">
                                    <td class="col-date">
                                        <div class="date-cell">
                                            <span class="date-num">@record.AttendanceDate.ToString("dd")</span>
                                            <span class="date-month">@record.AttendanceDate.ToString("MMM")</span>
                                        </div>
                                    </td>
                                    <td class="col-day">
                                        <span class="day-badge @(isSunday ? "sunday" : "")">
                                            @record.AttendanceDate.ToString("ddd")
                                        </span>
                                    </td>
                                    <td class="col-shift">
                                        @if (!string.IsNullOrEmpty(record.ShiftName))
                                        {
                                            <div class="shift-badge" title="@record.ShiftBeginTime - @record.ShiftEndTime">
                                                <i class="bi bi-clock"></i>
                                                @record.ShiftName
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-time">
                                        @if (!string.IsNullOrEmpty(record.InTime))
                                        {
                                            <div class="time-cell @(record.LateBy > 0 ? "late" : "ontime")">
                                                <span class="time-value">@record.InTime</span>
                                                @if (record.LateBy > 0)
                                                {
                                                    <i class="bi bi-arrow-down-short indicator"></i>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-time">
                                        @if (!string.IsNullOrEmpty(record.OutTime))
                                        {
                                            <div class="time-cell @(record.EarlyBy > 0 ? "early" : "")">
                                                <span class="time-value">@record.OutTime</span>
                                                @if (record.EarlyBy > 0)
                                                {
                                                    <i class="bi bi-arrow-up-short indicator warning"></i>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-duration">
                                        <span class="duration-badge">@record.FormattedDuration</span>
                                    </td>
                                    <td class="col-variance">
                                        @if (record.LateBy > 0)
                                        {
                                            <span class="variance-badge late">
                                                <i class="bi bi-clock"></i>
                                                @record.FormattedLateBy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-variance">
                                        @if (record.EarlyBy > 0)
                                        {
                                            <span class="variance-badge early">
                                                <i class="bi bi-clock"></i>
                                                @record.FormattedEarlyBy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-variance">
                                        @if (record.OverTime > 0)
                                        {
                                            <span class="variance-badge overtime">
                                                <i class="bi bi-plus-circle"></i>
                                                @record.FormattedOverTime
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-status">
                                        <div class="status-cell">
                                            <span class="status-badge @GetStatusClass(record.StatusCode)">
                                                @GetStatusIcon(record.StatusCode)
                                                @record.StatusDisplay
                                            </span>
                                            @if (record.MissedOutPunch == 1 || record.MissedInPunch == 1)
                                            {
                                                <span class="missed-alert" title="Missed Punch Detected">
                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="col-punches">
                                        @if (!string.IsNullOrEmpty(record.PunchRecords))
                                        {
                                            <div class="punches-cell" title="@record.PunchRecords">
                                                <code>@TruncateText(record.PunchRecords, 18)</code>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="no-data">—</span>
                                        }
                                    </td>
                                    <td class="col-action">
                                        <button class="btn-view" @onclick="@(() => ShowPunchDetails(record))" 
                                                title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Table Footer -->
                <div class="table-footer">
                    <div class="footer-summary">
                        <div class="summary-item">
                            <span class="dot present"></span>
                            Present: <strong>@monthlySummary?.PresentDays</strong>
                        </div>
                        <div class="summary-item">
                            <span class="dot absent"></span>
                            Absent: <strong>@monthlySummary?.AbsentDays</strong>
                        </div>
                        <div class="summary-item">
                            <span class="dot late"></span>
                            Late: <strong>@monthlySummary?.LateDays</strong>
                        </div>
                        <div class="summary-item">
                            <span class="dot leave"></span>
                            Leave: <strong>@monthlySummary?.LeaveDays</strong>
                        </div>
                        <div class="summary-item">
                            <span class="dot overtime"></span>
                            OT: <strong>@monthlySummary?.FormattedTotalOT</strong>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Calendar View -->
                <div class="calendar-view">
                    <div class="calendar-weekdays">
                        <span class="weekend">Sun</span>
                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span>Fri</span>
                        <span class="weekend">Sat</span>
                    </div>
                    <div class="calendar-days">
                        @{
                            var firstDay = new DateTime(selectedYear, selectedMonth, 1);
                            var daysInMonth = DateTime.DaysInMonth(selectedYear, selectedMonth);
                            var startOffset = (int)firstDay.DayOfWeek;
                        }
                        
                        @for (int i = 0; i < startOffset; i++)
                        {
                            <div class="calendar-day empty"></div>
                        }
                        
                        @for (int day = 1; day <= daysInMonth; day++)
                        {
                            var currentDate = new DateTime(selectedYear, selectedMonth, day);
                            var record = attendanceRecords.FirstOrDefault(r => r.AttendanceDate.Date == currentDate.Date);
                            var statusClass = GetCalendarDayClass(record, currentDate);
                            var isToday = currentDate.Date == DateTime.Today;
                            
                            <div class="calendar-day @statusClass @(isToday ? "today" : "")"
                                 @onclick="@(() => { if(record != null) ShowPunchDetails(record); })">
                                <span class="day-number">@day</span>
                                @if (record != null)
                                {
                                    <span class="day-status">@record.StatusCode</span>
                                    @if (!string.IsNullOrEmpty(record.InTime))
                                    {
                                        <span class="day-time">@record.InTime</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Punch Details Modal -->
@if (showPunchModal && selectedRecord != null)
{
    <div class="modal-backdrop" @onclick="ClosePunchModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-title">
                    <div class="title-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="title-text">
                        <h3>Punch Details</h3>
                        <p>@selectedRecord.AttendanceDate.ToString("dddd, MMMM dd, yyyy")</p>
                    </div>
                </div>
                <button class="modal-close" @onclick="ClosePunchModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Quick Info Cards -->
                <div class="info-cards">
                    <div class="info-card">
                        <i class="bi bi-clock icon"></i>
                        <div class="info-content">
                            <span class="info-label">Shift</span>
                            <span class="info-value">@(selectedRecord.ShiftName ?? "N/A")</span>
                            <span class="info-sub">@selectedRecord.ShiftBeginTime - @selectedRecord.ShiftEndTime</span>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="status-icon @GetStatusClass(selectedRecord.StatusCode)">
                            @GetStatusIcon(selectedRecord.StatusCode)
                        </div>
                        <div class="info-content">
                            <span class="info-label">Status</span>
                            <span class="info-value">@selectedRecord.StatusDisplay</span>
                        </div>
                    </div>
                    <div class="info-card">
                        <i class="bi bi-hourglass-split icon"></i>
                        <div class="info-content">
                            <span class="info-label">Duration</span>
                            <span class="info-value highlight">@selectedRecord.FormattedDuration</span>
                        </div>
                    </div>
                </div>

                <!-- Time Display -->
                <div class="time-display">
                    <div class="time-block checkin">
                        <div class="block-icon">
                            <i class="bi bi-box-arrow-in-right"></i>
                        </div>
                        <div class="block-content">
                            <span class="block-label">Check In</span>
                            <span class="block-time">@(selectedRecord.InTime ?? "—")</span>
                            @if (selectedRecord.LateBy > 0)
                            {
                                <span class="block-variance late">
                                    <i class="bi bi-arrow-down"></i> @selectedRecord.FormattedLateBy late
                                </span>
                            }
                        </div>
                    </div>

                    <div class="time-connector">
                        <div class="connector-line"></div>
                        <span class="connector-text">@selectedRecord.FormattedDuration</span>
                        <div class="connector-line"></div>
                    </div>

                    <div class="time-block checkout">
                        <div class="block-icon">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>
                        <div class="block-content">
                            <span class="block-label">Check Out</span>
                            <span class="block-time">@(selectedRecord.OutTime ?? "—")</span>
                            @if (selectedRecord.EarlyBy > 0)
                            {
                                <span class="block-variance early">
                                    <i class="bi bi-arrow-up"></i> @selectedRecord.FormattedEarlyBy early
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Stored Punches -->
                @if (!string.IsNullOrEmpty(selectedRecord.PunchRecords))
                {
                    <div class="section-block">
                        <h4><i class="bi bi-list-check"></i> Processed Punch Data</h4>
                        <div class="code-block">@selectedRecord.PunchRecords</div>
                    </div>
                }

                <!-- Raw Device Logs -->
                <div class="section-block">
                    <h4><i class="bi bi-cpu"></i> Raw Device Logs</h4>
                    
                    @if (isLoadingPunches)
                    {
                        <div class="inline-loading">
                            <div class="mini-spinner"></div>
                            <span>Loading device logs...</span>
                        </div>
                    }
                    else if (punchDetails.Any())
                    {
                        <div class="punch-timeline">
                            @{ int punchNum = 0; }
                            @foreach (var punch in punchDetails)
                            {
                                punchNum++;
                                var isIn = punch.Direction == "0" || punch.Direction?.ToUpper() == "IN";
                                
                                <div class="timeline-item @(isIn ? "in" : "out")">
                                    <div class="timeline-marker">
                                        <span class="marker-num">@punchNum</span>
                                    </div>
                                    <div class="timeline-content">
                                        <div class="timeline-header">
                                            <span class="punch-time">@punch.FormattedTime</span>
                                            <span class="direction-tag @(isIn ? "in" : "out")">
                                                <i class="bi bi-@(isIn ? "box-arrow-in-right" : "box-arrow-right")"></i>
                                                @(isIn ? "IN" : "OUT")
                                            </span>
                                        </div>
                                        <div class="timeline-details">
                                            <span class="detail">
                                                <i class="bi bi-router"></i>
                                                @(punch.DeviceName ?? "Unknown Device")
                                            </span>
                                            @if (punch.BodyTemperature.HasValue && punch.BodyTemperature > 0)
                                            {
                                                <span class="detail temp @(punch.BodyTemperature > 37.5 ? "high" : "")">
                                                    <i class="bi bi-thermometer-half"></i>
                                                    @punch.BodyTemperature.Value.ToString("F1")°C
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(punch.LocationAddress))
                                            {
                                                <span class="detail location" title="@punch.LocationAddress">
                                                    <i class="bi bi-geo-alt"></i>
                                                    @TruncateText(punch.LocationAddress, 25)
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="no-data-msg">
                            <i class="bi bi-inbox"></i>
                            <span>No raw device logs found for this date</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button class="btn-close-modal" @onclick="ClosePunchModal">
                    <i class="bi bi-x me-2"></i>Close
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================
     STYLES
     ============================================ -->
<style>
