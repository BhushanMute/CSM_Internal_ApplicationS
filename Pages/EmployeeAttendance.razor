        font-size: 12px;
        margin-top: 10px;
        padding: 4px 10px;
        border-radius: var(--radius-sm);
        width: fit-content;
    }

    .stat-trend.positive {
        background: var(--success-light);
        color: var(--success-dark);
    }

    .stat-trend.negative {
        background: var(--danger-light);
        color: var(--danger);
    }

    .stat-sub {
        font-size: 12px;
        color: var(--gray-400);
        margin-top: 6px;
    }

    .stat-decoration {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40px;
        opacity: 0.15;
    }

    .stat-decoration svg {
        width: 100%;
        height: 100%;
    }

    .stat-card.working .stat-decoration { color: var(--primary); }

    /* Progress Ring */
    .progress-ring {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 55px;
        height: 55px;
    }

    .progress-ring svg {
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
    }

    .ring-bg {
        fill: none;
        stroke: var(--gray-200);
        stroke-width: 3.5;
    }

    .ring-progress {
        fill: none;
        stroke: var(--success);
        stroke-width: 3.5;
        stroke-linecap: round;
        transition: stroke-dasharray 0.8s ease;
    }

    .ring-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 11px;
        font-weight: 700;
        color: var(--success);
    }

    /* ==========================================
       RECORDS SECTION
       ========================================== */
    .records-section {
        background: white;
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    .records-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid var(--gray-100);
        background: var(--gray-50);
        flex-wrap: wrap;
        gap: 16px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .header-left h2 {
        font-size: 18px;
        font-weight: 600;
        color: var(--gray-800);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-left h2 i {
        color: var(--primary);
    }

    .record-count {
        background: var(--primary);
        color: white;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .view-toggle {
        display: flex;
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .view-toggle button {
        padding: 10px 16px;
        border: none;
        background: transparent;
        color: var(--gray-500);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 16px;
    }

    .view-toggle button:hover {
        color: var(--gray-700);
        background: var(--gray-50);
    }

    .view-toggle button.active {
        background: var(--primary);
        color: white;
    }

    .legend {
        display: flex;
        gap: 16px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--gray-600);
    }

    .legend-item .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .legend-item.present .dot { background: var(--success); }
    .legend-item.absent .dot { background: var(--danger); }
    .legend-item.late .dot { background: var(--warning); }
    .legend-item.leave .dot { background: var(--info); }

    .records-body {
        min-height: 400px;
    }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px;
    }

    .loader {
        margin-bottom: 20px;
    }

    .loader-ring {
        display: inline-block;
        position: relative;
        width: 64px;
        height: 64px;
    }

    .loader-ring div {
        box-sizing: border-box;
        display: block;
        position: absolute;
        width: 52px;
        height: 52px;
        margin: 6px;
        border: 5px solid var(--primary);
        border-radius: 50%;
        animation: loader-ring 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
        border-color: var(--primary) transparent transparent transparent;
    }

    .loader-ring div:nth-child(1) { animation-delay: -0.45s; }
    .loader-ring div:nth-child(2) { animation-delay: -0.3s; }
    .loader-ring div:nth-child(3) { animation-delay: -0.15s; }

    @@keyframes loader-ring {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .loading-state p {
        color: var(--gray-500);
        font-size: 14px;
    }

    /* Empty State */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 40px;
        text-align: center;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        background: var(--gray-100);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
    }

    .empty-icon i {
        font-size: 44px;
        color: var(--gray-400);
    }

    .empty-state h3 {
        font-size: 22px;
        color: var(--gray-800);
        margin: 0 0 10px;
    }

    .empty-state p {
        color: var(--gray-500);
        margin: 0 0 24px;
        font-size: 15px;
    }

    .btn-secondary {
        display: flex;
        align-items: center;
        padding: 12px 24px;
        background: var(--gray-100);
        border: none;
        border-radius: var(--radius);
        color: var(--gray-700);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-secondary:hover {
        background: var(--gray-200);
    }

    /* ==========================================
       ATTENDANCE TABLE
       ========================================== */
    .table-wrapper {
        overflow-x: auto;
    }

    .attendance-table {
        width: 100%;
        border-collapse: collapse;
    }

    .attendance-table thead {
        background: var(--gray-50);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .attendance-table th {
        padding: 16px 14px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--gray-200);
        white-space: nowrap;
    }

    .attendance-table th i {
        font-size: 12px;
        margin-right: 4px;
    }

    .attendance-table td {
        padding: 16px 14px;
        font-size: 14px;
        color: var(--gray-700);
        border-bottom: 1px solid var(--gray-100);
        vertical-align: middle;
    }

    .attendance-table tbody tr {
        transition: background 0.15s;
    }

    .attendance-table tbody tr:hover {
        background: rgba(99, 102, 241, 0.04);
    }

    .attendance-table tbody tr.weekend-row {
        background: rgba(99, 102, 241, 0.02);
    }

    .attendance-table tbody tr.absent-row {
        background: rgba(239, 68, 68, 0.04);
    }

    .attendance-table tbody tr.absent-row:hover {
        background: rgba(239, 68, 68, 0.08);
    }

    .attendance-table tbody tr.weekoff-row {
        background: rgba(107, 114, 128, 0.04);
    }

    .attendance-table tbody tr.leave-row {
        background: rgba(245, 158, 11, 0.04);
    }

    .attendance-table tbody tr.holiday-row {
        background: rgba(59, 130, 246, 0.04);
    }

    /* Date Cell */
    .date-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 50px;
    }

    .date-num {
        font-size: 22px;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1;
    }

    .date-month {
        font-size: 11px;
        color: var(--gray-500);
        text-transform: uppercase;
        margin-top: 2px;
    }

    .day-badge {
        display: inline-block;
        padding: 4px 10px;
        background: var(--gray-100);
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-weight: 600;
        color: var(--gray-600);
    }

    .day-badge.sunday {
        background: var(--danger-light);
        color: var(--danger);
    }

    /* Shift Badge */
    .shift-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: var(--gray-100);
        border-radius: var(--radius-sm);
        font-size: 12px;
        color: var(--gray-700);
    }

    .shift-badge i {
        color: var(--gray-400);
        font-size: 12px;
    }

    .no-data {
        color: var(--gray-400);
        font-size: 13px;
    }

    /* Time Cells */
    .time-cell {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Monaco', 'Consolas', monospace;
        font-size: 13px;
    }

    .time-cell .time-value {
        color: var(--gray-800);
    }

    .time-cell.ontime .time-value {
        color: var(--success);
    }

    .time-cell.late .time-value {
        color: var(--danger);
        font-weight: 600;
    }

    .time-cell.early .time-value {
        color: var(--warning);
    }

    .time-cell .indicator {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--danger-light);
        color: var(--danger);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .time-cell .indicator.warning {
        background: var(--warning-light);
        color: var(--warning);
    }

    /* Duration */
    .duration-badge {
        font-weight: 700;
        color: var(--gray-800);
    }

    /* Variance Badges */
    .variance-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: var(--radius-sm);
        font-size: 11px;
        font-weight: 600;
    }

    .variance-badge.late {
        background: var(--danger-light);
        color: var(--danger);
    }

    .variance-badge.early {
        background: var(--warning-light);
        color: var(--warning);
    }

    .variance-badge.overtime {
        background: var(--success-light);
        color: var(--success-dark);
    }

    /* Status Cell */
    .status-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .status-badge.present {
        background: var(--success-light);
        color: var(--success-dark);
    }

    .status-badge.absent {
        background: var(--danger-light);
        color: var(--danger);
    }

    .status-badge.weekoff {
        background: var(--gray-200);
        color: var(--gray-600);
    }

    .status-badge.holiday {
        background: var(--info-light);
        color: var(--info);
    }

    .status-badge.leave {
        background: var(--warning-light);
        color: var(--warning-dark);
    }

    .status-badge.halfday {
        background: var(--purple-light);
        color: var(--purple);
    }

    .missed-alert {
        color: var(--warning);
        font-size: 16px;
        animation: blink 1.5s ease-in-out infinite;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    /* Punches Cell */
    .punches-cell code {
        font-size: 11px;
        background: var(--gray-100);
        padding: 5px 10px;
        border-radius: var(--radius-sm);
        color: var(--gray-600);
    }

    /* Action Button */
    .btn-view {
        width: 38px;
        height: 38px;
        border: 1px solid var(--gray-200);
        background: white;
        border-radius: var(--radius);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gray-500);
        font-size: 16px;
        transition: all 0.2s;
    }

    .btn-view:hover {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
        transform: scale(1.08);
    }

    /* Table Footer */
    .table-footer {
        padding: 18px 24px;
        background: var(--gray-50);
        border-top: 1px solid var(--gray-100);
    }

    .footer-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--gray-600);
    }

    .summary-item .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .summary-item .dot.present { background: var(--success); }
    .summary-item .dot.absent { background: var(--danger); }
    .summary-item .dot.late { background: var(--warning); }
    .summary-item .dot.leave { background: var(--info); }
    .summary-item .dot.overtime { background: var(--purple); }

    .summary-item strong {
        color: var(--gray-800);
    }

    /* ==========================================
       CALENDAR VIEW
       ========================================== */
    .calendar-view {
        padding: 24px;
    }

    .calendar-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        margin-bottom: 10px;
    }

    .calendar-weekdays span {
        text-align: center;
        font-size: 12px;
        font-weight: 700;
        color: var(--gray-500);
        text-transform: uppercase;
        padding: 10px;
    }

    .calendar-weekdays span.weekend {
        color: var(--danger);
    }

    .calendar-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }

    .calendar-day {
        aspect-ratio: 1;
        background: var(--gray-50);
        border-radius: var(--radius);
        padding: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
        border: 2px solid transparent;
    }

    .calendar-day:hover:not(.empty) {
        transform: scale(1.05);
        box-shadow: var(--shadow-md);
        z-index: 1;
    }

    .calendar-day.empty {
        background: transparent;
        cursor: default;
    }

    .calendar-day.today {
        border-color: var(--primary);
    }

    .calendar-day.present {
        background: var(--success-light);
        border-left: 4px solid var(--success);
    }

    .calendar-day.absent {
        background: var(--danger-light);
        border-left: 4px solid var(--danger);
    }

    .calendar-day.weekoff {
        background: var(--gray-200);
    }

    .calendar-day.leave {
        background: var(--warning-light);
        border-left: 4px solid var(--warning);
    }

    .calendar-day.holiday {
        background: var(--info-light);
        border-left: 4px solid var(--info);
    }

    .calendar-day .day-number {
        font-size: 18px;
        font-weight: 700;
        color: var(--gray-800);
    }

    .calendar-day .day-status {
        font-size: 10px;
        font-weight: 600;
        color: var(--gray-600);
        margin-top: 4px;
    }

    .calendar-day .day-time {
        font-size: 9px;
        color: var(--gray-500);
        font-family: monospace;
        margin-top: 4px;
    }

    /* ==========================================
       MODAL
       ========================================== */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-dialog {
        background: white;
        border-radius: var(--radius-xl);
        max-width: 720px;
        width: 100%;
        max-height: 90vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-xl);
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--purple) 100%);
        color: white;
    }

    .modal-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .title-icon {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,0.2);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .title-text h3 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
    }

    .title-text p {
        margin: 4px 0 0;
        opacity: 0.85;
        font-size: 14px;
    }

    .modal-close {
        width: 44px;
        height: 44px;
        background: rgba(255,255,255,0.15);
        border: none;
        border-radius: 50%;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        transition: all 0.2s;
    }

    .modal-close:hover {
        background: rgba(255,255,255,0.25);
        transform: rotate(90deg);
    }

    .modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    /* Info Cards */
    .info-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .info-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        background: var(--gray-50);
        border-radius: var(--radius);
    }

    .info-card .icon {
        font-size: 28px;
        color: var(--primary);
    }

    .info-card .status-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
    }

    .info-card .status-icon.present { background: var(--success); }
    .info-card .status-icon
    /* Continuing from .info-card .status-icon */
            /* Continuing from .info-card .status-icon */
            .info-card .status-icon.absent {
                background: var(--danger);
            }

            .info-card .status-icon.weekoff {
                background: var(--gray-500);
            }

            .info-card .status-icon.leave {
                background: var(--warning);
            }

            .info-card .status-icon.holiday {
                background: var(--info);
            }

    .info-content {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 11px;
        text-transform: uppercase;
        color: var(--gray-500);
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 16px;
        font-weight: 600;
        color: var(--gray-800);
    }

        .info-value.highlight {
            color: var(--primary);
        }

    .info-sub {
        font-size: 11px;
        color: var(--gray-500);
        margin-top: 2px;
    }

    /* Time Display */
    .time-display {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        padding: 28px;
        background: linear-gradient(135deg, var(--gray-50) 0%, white 100%);
        border-radius: var(--radius-lg);
        margin-bottom: 24px;
    }

    .time-block {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 28px;
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        min-width: 200px;
    }

        .time-block .block-icon {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .time-block.checkin .block-icon {
            background: var(--success-light);
            color: var(--success);
        }

        .time-block.checkout .block-icon {
            background: var(--danger-light);
            color: var(--danger);
        }

    .block-content {
        display: flex;
        flex-direction: column;
    }

    .block-label {
        font-size: 12px;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .block-time {
        font-size: 26px;
        font-weight: 700;
        color: var(--gray-800);
    }

    .block-variance {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        margin-top: 4px;
    }

        .block-variance.late {
            color: var(--danger);
        }

        .block-variance.early {
            color: var(--warning);
        }

    .time-connector {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .connector-line {
        width: 2px;
        height: 24px;
        background: var(--gray-300);
    }

    .connector-text {
        background: var(--primary);
        color: white;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 600;
    }

    /* Section Block */
    .section-block {
        margin-bottom: 24px;
    }

        .section-block h4 {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 600;
            color: var(--gray-800);
            margin: 0 0 14px;
        }

            .section-block h4 i {
                color: var(--primary);
            }

    .code-block {
        background: var(--gray-100);
        padding: 14px 18px;
        border-radius: var(--radius);
        font-family: 'Monaco', 'Consolas', monospace;
        font-size: 13px;
        color: var(--gray-700);
        overflow-x: auto;
        border-left: 4px solid var(--primary);
    }

    /* Inline Loading */
    .inline-loading {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px;
        color: var(--gray-600);
    }

    .mini-spinner {
        width: 22px;
        height: 22px;
        border: 3px solid var(--gray-200);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    /* Punch Timeline */
    .punch-timeline {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .timeline-item {
        display: flex;
        gap: 18px;
    }

    .timeline-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .marker-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--gray-200);
        color: var(--gray-600);
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .timeline-item.in .marker-num {
        background: var(--success-light);
        color: var(--success-dark);
    }

    .timeline-item.out .marker-num {
        background: var(--danger-light);
        color: var(--danger);
    }

    .timeline-content {
        flex: 1;
        background: var(--gray-50);
        border-radius: var(--radius);
        padding: 14px 18px;
        border-left: 3px solid var(--gray-300);
    }

    .timeline-item.in .timeline-content {
        border-left-color: var(--success);
    }

    .timeline-item.out .timeline-content {
        border-left-color: var(--danger);
    }

    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .punch-time {
        font-size: 18px;
        font-weight: 700;
        color: var(--gray-800);
    }

    .direction-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: var(--radius-sm);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

        .direction-tag.in {
            background: var(--success-light);
            color: var(--success-dark);
        }

        .direction-tag.out {
            background: var(--danger-light);
            color: var(--danger);
        }

    .timeline-details {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

        .timeline-details .detail {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--gray-600);
        }

            .timeline-details .detail i {
                color: var(--gray-400);
            }

            .timeline-details .detail.temp {
                color: var(--success);
            }

                .timeline-details .detail.temp.high {
                    color: var(--danger);
                    font-weight: 600;
                }

            .timeline-details .detail.location {
                color: var(--gray-500);
            }

    /* No Data Message */
    .no-data-msg {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 24px;
        background: var(--warning-light);
        border-radius: var(--radius);
        color: var(--warning-dark);
        font-size: 14px;
    }

        .no-data-msg i {
            font-size: 20px;
        }

    /* Modal Footer */
    .modal-footer {
        padding: 18px 24px;
        border-top: 1px solid var(--gray-100);
        display: flex;
        justify-content: flex-end;
        background: var(--gray-50);
    }

    .btn-close-modal {
        display: flex;
        align-items: center;
        padding: 12px 28px;
        background: var(--gray-200);
        border: none;
        border-radius: var(--radius);
        color: var(--gray-700);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-close-modal:hover {
            background: var(--gray-300);
        }

    /* ==========================================
           RESPONSIVE DESIGN
           ========================================== */
    @@media (max-width: 1200px) {
        .profile-content

    {
        flex-direction: column;
        align-items: flex-start;
    }

    .profile-actions {
        width: 100%;
        justify-content: flex-start;
    }

    .info-cards {
        grid-template-columns: 1fr;
    }

    .time-display {
        flex-direction: column;
    }

    .time-connector {
        flex-direction: row;
    }

    .connector-line {
        width: 40px;
        height: 2px;
    }

    }

    @@media (max-width: 768px) {
        .employee-attendance-page

    {
        padding: 16px;
    }

    .profile-main {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-info h1 {
        font-size: 24px;
    }

    .profile-meta {
        justify-content: center;
    }

    .profile-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .month-selector {
        width: 100%;
    }

    .month-dropdown select {
        width: 100%;
    }

    .action-buttons {
        justify-content: center;
    }

    .records-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .header-right {
        width: 100%;
        justify-content: space-between;
    }

    .legend {
        display: none;
    }

    .attendance-table th,
    .attendance-table td {
        padding: 12px 10px;
        font-size: 12px;
    }

    .date-num {
        font-size: 18px;
    }

    .time-block {
        min-width: auto;
        padding: 16px;
    }

    .block-time {
        font-size: 20px;
    }

    .modal-dialog {
        max-height: 95vh;
        margin: 10px;
    }

    .modal-header {
        padding: 18px;
    }

    .title-icon {
        width: 44px;
        height: 44px;
        font-size: 22px;
    }

    .title-text h3 {
        font-size: 18px;
    }

    .modal-body {
        padding: 18px;
    }

    .footer-summary {
        gap: 14px;
    }

    }

    @@media (max-width: 480px) {
        .analytics-grid

    {
        grid-template-columns: 1fr;
    }

    .stat-card {
