    .stat-card {
        position: relative;
        background: white;
        border-radius: var(--radius-lg);
        padding: 22px;
        overflow: hidden;
        box-shadow: var(--shadow);
        transition: transform 0.25s, box-shadow 0.25s;
        border-top: 4px solid transparent;
    }

    .stat-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-lg);
    }

    .stat-card.working { border-top-color: var(--primary); }
    .stat-card.present { border-top-color: var(--success); }
    .stat-card.absent { border-top-color: var(--danger); }
    .stat-card.late { border-top-color: var(--warning); }
    .stat-card.leave { border-top-color: var(--info); }
    .stat-card.overtime { border-top-color: var(--purple); }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }

    .stat-icon i {
        font-size: 26px;
    }

    .stat-card.working .stat-icon { background: var(--primary-bg); color: var(--primary); }
    .stat-card.present .stat-icon { background: var(--success-light); color: var(--success); }
    .stat-card.absent .stat-icon { background: var(--danger-light); color: var(--danger); }
    .stat-card.late .stat-icon { background: var(--warning-light); color: var(--warning); }
    .stat-card.leave .stat-icon { background: var(--info-light); color: var(--info); }
    .stat-card.overtime .stat-icon { background: var(--purple-light); color: var(--purple); }

    .stat-content {
