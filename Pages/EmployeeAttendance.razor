@code {
    // ==========================================
    // PARAMETERS
    // ==========================================
    [Parameter]
    public int EmployeeId { get; set; }

    // ==========================================
    // STATE VARIABLES
    // ==========================================
    private Employee? employee;
    private List<DailyAttendanceRecord> attendanceRecords = new();
    private EmployeeMonthlyAttendanceSummary? monthlySummary;
    private List<AttendanceMonthInfo> availableMonths = new();
    private List<PunchDetail> punchDetails = new();

    // Selected month tracking
    private string selectedMonthKey = $"{DateTime.Now.Month}_{DateTime.Now.Year}";
    private int selectedMonth => int.Parse(selectedMonthKey.Split('_')[0]);
    private int selectedYear => int.Parse(selectedMonthKey.Split('_')[1]);

    // UI State
    private bool isLoading = true;
    private bool isExporting = false;
    private bool isLoadingPunches = false;
    private bool showPunchModal = false;
    private string viewMode = "table"; // "table" or "calendar"
    private DailyAttendanceRecord? selectedRecord;

    // ==========================================
    // LIFECYCLE METHODS
    // ==========================================
    protected override async Task OnInitializedAsync()
    {
        await LoadEmployee();
        await LoadAvailableMonths();
        await LoadAttendance();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload if employee ID changes
        if (employee != null && employee.EmployeeId != EmployeeId)
        {
            await LoadEmployee();
            await LoadAvailableMonths();
            await LoadAttendance();
        }
    }

    public void Dispose()
    {
        // Cleanup if needed
    }

    // ==========================================
    // DATA LOADING METHODS
    // ==========================================
    private async Task LoadEmployee()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Try to get employee by ID
            var employees = await EmployeeRepository.GetAllAsync(1, 1000);
            employee = employees.FirstOrDefault(e => e.EmployeeId == EmployeeId);

            if (employee == null)
            {
                Logger.LogWarning("Employee with ID {EmployeeId} not found", EmployeeId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employee {EmployeeId}", EmployeeId);
        }
    }

    private async Task LoadAvailableMonths()
    {
        try
        {
            availableMonths = (await AttendanceRepository.GetAvailableAttendanceMonthsAsync(EmployeeId)).ToList();

            if (availableMonths.Any())
            {
                var firstMonth = availableMonths.First();
                selectedMonthKey = $"{firstMonth.AttMonth}_{firstMonth.AttYear}";
            }
            else
            {
                // Default to current month if no data exists
                selectedMonthKey = $"{DateTime.Now.Month}_{DateTime.Now.Year}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading available months for employee {EmployeeId}", EmployeeId);
        }
    }

    private async Task LoadAttendance()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load attendance records
            attendanceRecords = (await AttendanceRepository.GetEmployeeMonthlyAttendanceAsync(
                EmployeeId, selectedMonth, selectedYear)).ToList();

            // Load summary
            monthlySummary = await AttendanceRepository.GetEmployeeMonthlyAttendanceSummaryAsync(
                EmployeeId, selectedMonth, selectedYear);

            Logger.LogInformation(
                "Loaded {Count} attendance records for employee {EmployeeId}, {Month}/{Year}",
                attendanceRecords.Count, EmployeeId, selectedMonth, selectedYear);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading attendance for employee {EmployeeId}", EmployeeId);
            attendanceRecords = new();
            monthlySummary = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadAttendance();
    }

    // ==========================================
    // EVENT HANDLERS
    // ==========================================
    private async Task OnMonthChanged()
    {
        await LoadAttendance();
    }

    private void SelectPreviousMonth()
    {
        if (availableMonths.Count > 1)
        {
            var currentIndex = availableMonths.FindIndex(m =>
                $"{m.AttMonth}_{m.AttYear}" == selectedMonthKey);

            if (currentIndex < availableMonths.Count - 1)
            {
                var previousMonth = availableMonths[currentIndex + 1];
                selectedMonthKey = $"{previousMonth.AttMonth}_{previousMonth.AttYear}";
                _ = LoadAttendance();
            }
        }
    }

    private async Task ShowPunchDetails(DailyAttendanceRecord record)
    {
        selectedRecord = record;
        showPunchModal = true;
        isLoadingPunches = true;
        punchDetails = new();
        StateHasChanged();

        try
        {
            punchDetails = (await AttendanceRepository.GetEmployeePunchDetailsByMonthAsync(
                EmployeeId, selectedMonth, selectedYear, record.AttendanceDate)).ToList();

            Logger.LogInformation(
                "Loaded {Count} punch details for employee {EmployeeId} on {Date}",
                punchDetails.Count, EmployeeId, record.AttendanceDate);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading punch details");
            punchDetails = new();
        }
        finally
        {
            isLoadingPunches = false;
            StateHasChanged();
        }
    }

    private void ClosePunchModal()
    {
        showPunchModal = false;
        selectedRecord = null;
        punchDetails = new();
    }

    // ==========================================
    // EXPORT & PRINT METHODS
    // ==========================================
    private async Task ExportToExcel()
    {
        if (!attendanceRecords.Any()) return;

        isExporting = true;
        StateHasChanged();

        try
        {
            var employeeName = employee?.EmployeeName ?? "Employee";
            var monthYear = GetSelectedMonthName();

            var excelBytes = ExcelService.ExportAttendanceToExcel(
                attendanceRecords, employeeName, monthYear);

            var fileName = $"Attendance_{employeeName.Replace(" ", "_")}_{monthYear.Replace(" ", "_")}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, excelBytes);

            Logger.LogInformation("Exported attendance for {Employee} - {Month}", employeeName, monthYear);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting attendance to Excel");
            // You could show a toast notification here
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task PrintReport()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error printing report");
        }
    }

    // ==========================================
    // NAVIGATION
    // ==========================================
    private void GoBack()
    {
        Navigation.NavigateTo("/attendance");
    }

    // ==========================================
    // HELPER METHODS - Display Formatting
    // ==========================================
    private string GetSelectedMonthName()
    {
        var match = availableMonths.FirstOrDefault(m =>
            m.AttMonth == selectedMonth && m.AttYear == selectedYear);

        if (match != null)
        {
            return $"{match.MonthName} {match.AttYear}";
        }

        return new DateTime(selectedYear, selectedMonth, 1).ToString("MMMM yyyy");
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }

        return name.Length >= 2
            ? name[..2].ToUpper()
            : name.ToUpper();
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "—";

        return text.Length <= maxLength
            ? text
            : text[..(maxLength - 3)] + "...";
    }

    // ==========================================
    // HELPER METHODS - CSS Classes
    // ==========================================
    private string GetAvatarColorClass()
    {
        if (monthlySummary == null) return "";

        // Color based on attendance percentage
        if (monthlySummary.PresentPercentage >= 90) return "present-avatar";
        if (monthlySummary.PresentPercentage < 70) return "absent-avatar";

        return "";
    }

    private string GetRowClass(DailyAttendanceRecord record)
    {
        if (record.Absent > 0) return "absent-row";
        if (record.WeeklyOff == 1) return "weekoff-row";
        if (record.Holiday == 1) return "holiday-row";
        if (record.IsOnLeave == 1) return "leave-row";
        return "";
    }

    private string GetStatusClass(string? statusCode)
    {
        return statusCode?.ToUpper() switch
        {
            "P" => "present",
            "A" => "absent",
            "WO" => "weekoff",
            "H" => "holiday",
            "L" => "leave",
            "HD" => "halfday",
            "MP" => "absent",
            _ => "weekoff"
        };
    }

    private string GetStatusIcon(string? statusCode)
    {
        return statusCode?.ToUpper() switch
        {
            "P" => "✓",
            "A" => "✗",
            "WO" => "○",
            "H" => "★",
            "L" => "◐",
            "HD" => "½",
            "MP" => "⚠",
            _ => "•"
        };
    }

    private string GetCalendarDayClass(DailyAttendanceRecord? record, DateTime date)
    {
        if (record == null) return "no-record";

        if (record.Absent > 0) return "absent";
        if (record.WeeklyOff == 1) return "weekoff";
        if (record.Holiday == 1) return "holiday";
        if (record.IsOnLeave == 1) return "leave";
        if (!string.IsNullOrEmpty(record.InTime)) return "present";

        return "no-record";
    }

    // ==========================================
    // HELPER METHODS - Status Badge Classes
    // ==========================================
    private string GetStatusBadgeClass(string? statusCode)
    {
        return statusCode?.ToUpper() switch
        {
            "P" => "bg-success",
            "A" => "bg-danger",
            "WO" => "bg-secondary",
            "H" => "bg-info",
            "L" => "bg-warning text-dark",
            "HD" => "bg-warning text-dark",
            "MP" => "bg-dark",
            _ => "bg-secondary"
        };
    }

    // ==========================================
    // COMPUTED PROPERTIES
    // ==========================================
    private bool HasAttendanceData => attendanceRecords.Any();

    private double AttendancePercentage => monthlySummary?.PresentPercentage ?? 0;

    private bool IsCurrentMonth =>
        selectedMonth == DateTime.Now.Month &&
        selectedYear == DateTime.Now.Year;
}