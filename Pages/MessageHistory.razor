@page "/absencehistory"
@using CSMTutorial.Data.Repositories
 @inject ITeacherAbsenceService TeacherService
@inject NavigationManager Navigation

<style>
    .history-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-header {
        background: linear-gradient(135deg, #fc4a1a 0%, #f7b733 100%);
        color: white;
        padding: 25px 30px;
        border-radius: 12px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(252, 74, 26, 0.4);
    }

        .page-header h2 {
            margin: 0;
            font-size: 24px;
        }

    /* History Card */
    .history-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        margin-bottom: 16px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .history-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }

    .history-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .history-card-header h4 {
            margin: 0;
            font-size: 16px;
            color: #333;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .history-card-body {
        padding: 20px 24px;
    }

    .history-meta {
        display: flex;
        gap: 30px;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        flex-direction: column;
    }

    .meta-label {
        font-size: 12px;
        color: #888;
        margin-bottom: 4px;
    }

    .meta-value {
        font-size: 14px;
        color: #333;
        font-weight: 500;
    }

    /* Stats in card */
    .history-stats {
        display: flex;
        gap: 20px;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #f0f0f0;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }

    .stat-total {
        background: #e8f4fd;
        color: #1976d2;
    }

    .stat-sent {
        background: #e8f5e9;
        color: #388e3c;
    }

    .stat-failed {
        background: #ffebee;
        color: #d32f2f;
    }

    /* Message Type Badge */
    .type-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .type-today {
        background: #fff3e0;
        color: #e65100;
    }

    .type-tomorrow {
        background: #e3f2fd;
        color: #1565c0;
    }

    /* Reason Preview */
    .reason-preview {
        background: #f8f9fa;
        padding: 12px 16px;
        border-radius: 8px;
        margin-top: 12px;
        font-size: 14px;
        color: #555;
        border-left: 4px solid #667eea;
    }

    /* Filter Section */
    .filter-section {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .filter-row {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1;
        min-width: 150px;
    }

        .filter-group label {
            display: block;
            font-size: 13px;
            color: #666;
            margin-bottom: 6px;
        }

        .filter-group input,
        .filter-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
        }

    .btn-filter {
        background: linear-gradient(135deg, #fc4a1a 0%, #f7b733 100%);
        color: white;
        padding: 10px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-new {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-new:hover {
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

    .btn-details {
        background: #f0f0f0;
        color: #333;
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-details:hover {
            background: #e0e0e0;
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #888;
    }

        .empty-state h3 {
            margin: 20px 0 10px;
            color: #555;
        }

    /* Loading */
    .loading {
        text-align: center;
        padding: 60px;
    }

        .loading .loader {
            width: 50px;
            height: 50px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #fc4a1a;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
</style>

<div class="history-container">
    <!-- Page Header -->
    <div class="page-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2>📚 Message History</h2>
                <p>View all past teacher absence notifications</p>
            </div>
            <button class="btn-new" @onclick="CreateNewMessage">
                ➕ New Notification
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-section">
        <div class="filter-row">
            <div class="filter-group">
                <label>From Date</label>
                <input type="date" @bind="filterFromDate" />
            </div>
            <div class="filter-group">
                <label>To Date</label>
                <input type="date" @bind="filterToDate" />
            </div>
            <div class="filter-group">
                <label>Company</label>
                <select @bind="filterCompanyId">
                    <option value="">All Companies</option>
                    @foreach (var company in companies)
                    {
                        <option value="@company.CompanyId">@company.CompanyName</option>
                    }
                </select>
            </div>
            <button class="btn-filter" @onclick="LoadHistory">🔍 Search</button>
        </div>
    </div>

    <!-- History List -->
    @if (isLoading)
    {
        <div class="loading">
            <div class="loader"></div>
            <p>Loading message history...</p>
        </div>
    }
    else if (messages.Count == 0)
    {
        <div class="empty-state">
            <div style="font-size: 64px;">📭</div>
            <h3>No Messages Found</h3>
            <p>You haven't sent any absence notifications yet, or no messages match your filters.</p>
            <button class="btn-new" style="margin-top: 20px;" @onclick="CreateNewMessage">
                ➕ Send First Notification
            </button>
        </div>
    }
    else
    {
        @foreach (var message in messages)
        {
            <div class="history-card">
                <div class="history-card-header">
                    <h4>
                        <span class="type-badge @(message.MessageType == "Today" ? "type-today" : "type-tomorrow")">
                            @message.MessageType's Class
                        </span>
                        @message.CompanyName
                    </h4>
                    <button class="btn-details" @onclick="() => ViewDetails(message.MessageId)">
                        View Details →
                    </button>
                </div>
                <div class="history-card-body">
                    <div class="history-meta">
                        <div class="meta-item">
                            <span class="meta-label">Date Sent</span>
                            <span class="meta-value">
                                @(message.SentDate?.ToString("dd MMM yyyy, hh:mm tt") ?? message.CreatedDate?.ToString("dd MMM yyyy, hh:mm tt"))
                            </span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Sent By</span>
                            <span class="meta-value">@message.CreatedBy</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Status</span>
                            <span class="meta-value">@message.Status</span>
                        </div>
                    </div>

                    <div class="reason-preview">
                        <strong>Reason:</strong> @message.Reason
                    </div>

                    <div class="history-stats">
                        <span class="stat-item stat-total">
                            📊 Total: @message.TotalRecipients
                        </span>
                        <span class="stat-item stat-sent">
                            ✅ Sent: @message.SentCount
                        </span>
                        <span class="stat-item stat-failed">
                            ❌ Failed: @message.FailedCount
                        </span>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<CompanyDropdown> companies = new();
    private List<TeacherAbsenceMessage> messages = new();

    private DateTime? filterFromDate = DateTime.Today.AddMonths(-1);
    private DateTime? filterToDate = DateTime.Today;
    private int? filterCompanyId;

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
        await LoadHistory();
    }

    private async Task LoadCompanies()
    {
        companies = await TeacherService.GetCompaniesAsync();
    }

    private async Task LoadHistory()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            messages = await TeacherService.GetMessageHistoryAsync(
                filterFromDate,
                filterToDate,
                filterCompanyId,
                1,
                100
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CreateNewMessage()
    {
        Navigation.NavigateTo("/absence");
    }

    private void ViewDetails(long messageId)
    {
        Navigation.NavigateTo($"/status?messageId={messageId}");
    }
}