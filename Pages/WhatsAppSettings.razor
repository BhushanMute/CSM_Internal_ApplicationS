@code {
    // Data
     
    private CSMTutorial.Models.WhatsAppSettings settings = new();
    private WhatsAppUsageStats stats = new();
    // UI State
    private string tab = "api";
    private bool isLoading = false;
    private bool isSaving = false;
    private bool isTesting = false;
    private bool isSendingTest = false;
    private string connectionStatus = "Unknown";
    private string alertMessage = "";
    private string alertClass = "";

    // Password Visibility
    private bool showKey = false;
    private bool showSecret = false;
    private bool showSid = false;

    // Test
    private string testPhone = "";
    private string testMsg = "";
    private string testResult = "";
    private bool testOk = false;

    // Template ref helpers (for append)
    private string checkInRef = "";
    private string checkOutRef = "";

    // Variable Lists
    private List<string> checkVars = new()
    {
        "{StudentName}", "{Time}", "{Date}",
        "{BranchName}", "{CourseName}"
    };

    private List<string> absenceVars = new()
    {
        "{StudentName}", "{Date}", "{Reason}"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
        await LoadStats();
    }

    private async Task LoadSettings()
    {
        try
        {
            isLoading = true;
            settings = await SettingsService.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Error loading settings: {ex.Message}", "alert-danger");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStats()
    {
        try
        {
            stats = await SettingsService.GetUsageStatsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Stats error: {ex.Message}");
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            isSaving = true;
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User.Identity?.Name ?? "Admin";
            var ok = await SettingsService.SaveSettingsAsync(settings, user);
            ShowAlert(
                ok ? "✅ Settings saved successfully!" : "❌ Failed to save settings.",
                ok ? "alert-success" : "alert-danger"
            );
        }
        catch (Exception ex)
        {
            ShowAlert($"Error: {ex.Message}", "alert-danger");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TestConnection()
    {
        try
        {
            isTesting = true;
            connectionStatus = "Unknown";
            var ok = await SettingsService.TestConnectionAsync(
                settings.ApiUrl, settings.ApiKey);
            connectionStatus = ok ? "Connected" : "Disconnected";
            ShowAlert(
                ok ? "✅ Connection successful!"
                   : "❌ Connection failed. Check API settings.",
                ok ? "alert-success" : "alert-danger"
            );
        }
        catch (Exception ex)
        {
            connectionStatus = "Disconnected";
            ShowAlert($"Connection error: {ex.Message}", "alert-danger");
        }
        finally
        {
            isTesting = false;
        }
    }

    private async Task SendTestMessage()
    {
        try
        {
            isSendingTest = true;
            testResult = "";
            var (ok, msg) = await SettingsService.SendTestMessageAsync(
                testPhone, testMsg);
            testOk = ok;
            testResult = msg;
        }
        catch (Exception ex)
        {
            testOk = false;
            testResult = ex.Message;
        }
        finally
        {
            isSendingTest = false;
        }
    }

    // ===== Connection Status Helpers =====
    private string GetConnClass() => connectionStatus switch
    {
        "Connected" => "conn-connected",
        "Disconnected" => "conn-disconnected",
        _ => "conn-unknown"
    };

    private string GetDotClass() => connectionStatus switch
    {
        "Connected" => "dot-green",
        "Disconnected" => "dot-red",
        _ => "dot-yellow"
    };

    private string GetConnText() => connectionStatus switch
    {
        "Connected" => "✅ API Connected & Working",
        "Disconnected" => "❌ API Not Connected",
        _ => "⚠️ Connection Status Unknown - Click Test Connection"
    };

    // ===== Template Previews =====
    private string GetCheckInPreview()
    {
        return (settings.CheckInMessageFormat ?? "No template set.")
            .Replace("{StudentName}", "Ahmad Ali")
            .Replace("{Time}", DateTime.Now.ToString("hh:mm tt"))
            .Replace("{Date}", DateTime.Today.ToString("dd-MMM-yyyy"))
            .Replace("{BranchName}", "CSM Tutorial")
            .Replace("{CourseName}", "Mathematics");
    }

    private string GetCheckOutPreview()
    {
        return (settings.CheckOutMessageFormat ?? "No template set.")
            .Replace("{StudentName}", "Ahmad Ali")
            .Replace("{Time}", DateTime.Now.ToString("hh:mm tt"))
            .Replace("{Date}", DateTime.Today.ToString("dd-MMM-yyyy"))
            .Replace("{BranchName}", "CSM Tutorial")
            .Replace("{CourseName}", "Mathematics");
    }

    private string GetTodayPreview()
    {
        return (settings.TodayTemplate ?? "No template set.")
            .Replace("{StudentName}", "Ahmad Ali")
            .Replace("{Date}", DateTime.Today.ToString("dd-MMM-yyyy"))
            .Replace("{Reason}", "Teacher is unwell");
    }

    private string GetTomorrowPreview()
    {
        return (settings.TomorrowTemplate ?? "No template set.")
            .Replace("{StudentName}", "Ahmad Ali")
            .Replace("{Date}", DateTime.Today.AddDays(1).ToString("dd-MMM-yyyy"))
            .Replace("{Reason}", "Teacher is unwell");
    }

    // ===== Variable Append Helper =====
    private void AppendVar(ref string field, string variable)
    {
        field += variable;
    }

    // ===== Reset Templates =====
    private void ResetCheckInTemplate()
    {
        settings.CheckInMessageFormat =
@"Dear {StudentName},

Your child has checked IN at {BranchName}.
Time: {Time}
Date: {Date}
Course: {CourseName}

Regards,
Management";
    }

    private void ResetCheckOutTemplate()
    {
        settings.CheckOutMessageFormat =
@"Dear {StudentName},

Your child has checked OUT from {BranchName}.
Time: {Time}
Date: {Date}
Course: {CourseName}

Regards,
Management";
    }

    private void ResetTodayTemplate()
    {
        settings.TodayTemplate =
@"Dear {StudentName},

Today's class ({Date}) is cancelled due to: {Reason}.

We apologize for the inconvenience.

Regards,
Management";
    }

    private void ResetTomorrowTemplate()
    {
        settings.TomorrowTemplate =
@"Dear {StudentName},

Tomorrow's class ({Date}) is cancelled due to: {Reason}.

We apologize for the inconvenience.

Regards,
Management";
    }

    // ===== Quick Fill Test =====
    private void FillCheckInTest()
    {
        testMsg = GetCheckInPreview();
    }

    private void FillCheckOutTest()
    {
        testMsg = GetCheckOutPreview();
    }

    private void FillTodayTest()
    {
        testMsg = (settings.TodayTemplate ?? "")
            .Replace("{StudentName}", "Test Student")
            .Replace("{Date}", DateTime.Today.ToString("dd-MMM-yyyy"))
            .Replace("{Reason}", "Test reason");
    }

    private void FillTomorrowTest()
    {
        testMsg = (settings.TomorrowTemplate ?? "")
            .Replace("{StudentName}", "Test Student")
            .Replace("{Date}", DateTime.Today.AddDays(1).ToString("dd-MMM-yyyy"))
            .Replace("{Reason}", "Test reason");
    }

    private void ClearTest()
    {
        testPhone = "";
        testMsg = "";
        testResult = "";
        testOk = false;
    }

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
    }
}