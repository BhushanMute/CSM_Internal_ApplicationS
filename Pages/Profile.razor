@code {
    private string activeTab = "overview";
    private ChangePasswordModel changePasswordModel = new();
    private List<LoginHistory> loginHistory = new();
    private string passwordMessage = string.Empty;
    private bool passwordSuccess = false;
    private bool isChangingPassword = false;
    private bool isLoadingHistory = true;
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLoginHistory();
    }

    private async Task LoadLoginHistory()
    {
        try
        {
            if (AuthService.CurrentUser != null)
            {
                loginHistory = (await AuthService.GetLoginHistoryAsync(AuthService.CurrentUser.UserId)).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading login history");
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task HandleChangePassword()
    {
        if (AuthService.CurrentUser == null) return;

        isChangingPassword = true;
        passwordMessage = string.Empty;

        try
        {
            var result = await AuthService.ChangePasswordAsync(AuthService.CurrentUser.UserId, changePasswordModel);
            passwordSuccess = result.Success;
            passwordMessage = result.Message;

            if (result.Success)
                changePasswordModel = new ChangePasswordModel();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing password");
            passwordSuccess = false;
            passwordMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private void ClearPasswordMessage() => passwordMessage = string.Empty;

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private int GetPasswordStrength()
    {
        var pwd = changePasswordModel.NewPassword ?? "";
        int score = 0;
        if (pwd.Length >= 6) score++;
        if (pwd.Any(char.IsUpper)) score++;
        if (pwd.Any(char.IsDigit)) score++;
        if (pwd.Any(c => !char.IsLetterOrDigit(c))) score++;
        return score;
    }

    private string GetStrengthClass() => GetPasswordStrength() switch
    {
        1 => "weak",
        2 => "fair",
        3 => "good",
        4 => "strong",
        _ => ""
    };

    private string GetStrengthText() => GetPasswordStrength() switch
    {
        1 => "Weak",
        2 => "Fair",
        3 => "Good",
        4 => "Strong",
        _ => ""
    };

    private string GetStrengthTextClass() => GetPasswordStrength() switch
    {
        1 => "text-danger",
        2 => "text-warning",
        3 => "text-primary",
        4 => "text-success",
        _ => "text-muted"
    };

    private string GetTimelineIcon(string status) => status switch
    {
        "Success" => "bi-check-circle-fill",
        "Failed" => "bi-x-circle-fill",
        "Locked" => "bi-lock-fill",
        _ => "bi-circle"
    };

    private string GetLoginStatusText(string status) => status switch
    {
        "Success" => "Successful Login",
        "Failed" => "Failed Login Attempt",
        "Locked" => "Account Locked",
        _ => "Login Event"
    };

    private string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.Now - dateTime;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dateTime.ToString("MMM dd");
    }

    private string GetDaysSinceLastLogin()
    {
        if (AuthService.CurrentUser?.LastLoginDate == null) return "0";
        return ((int)(DateTime.Now - AuthService.CurrentUser.LastLoginDate.Value).TotalDays).ToString();
    }

    private List<(string Label, int Count)> GetLast7DaysActivity()
    {
        var result = new List<(string Label, int Count)>();
        for (int i = 6; i >= 0; i--)
        {
            var date = DateTime.Now.Date.AddDays(-i);
            var count = loginHistory.Count(l => l.LoginTime.Date == date);
            result.Add((date.ToString("ddd"), count));
        }
        return result;
    }
}