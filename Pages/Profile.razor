@page "/profile"
@using CSMTutorial.Models
@using CSMTutorial.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Profile> Logger

<PageTitle>My Profile</PageTitle>

<div class="profile-page">
    <div class="container py-4">

        <!-- Profile Header Banner -->
        <div class="profile-banner mb-4">
            <div class="banner-overlay"></div>
            <div class="banner-content">
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <div class="profile-avatar-wrapper">
                        <div class="profile-avatar">
                            <span>@GetInitials(AuthService.CurrentUser?.LoginName)</span>
                        </div>
                        <div class="avatar-status online"></div>
                    </div>
                    <div class="profile-header-info">
                        <h2 class="mb-1 text-white fw-bold">@AuthService.CurrentUser?.LoginName</h2>
                        <p class="text-white-50 mb-2">
                            <i class="bi bi-envelope me-1"></i>@(AuthService.CurrentUser?.Email ?? "No email set")
                        </p>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (AuthService.IsAdmin)
                            {
                                <span class="profile-badge admin">
                                    <i class="bi bi-shield-check me-1"></i>Administrator
                                </span>
                            }
                            else
                            {
                                <span class="profile-badge user">
                                    <i class="bi bi-person me-1"></i>User
                                </span>
                            }
                            <span class="profile-badge active">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Active
                            </span>
                        </div>
                    </div>
                    <div class="ms-auto d-none d-md-block">
                        <div class="header-stats d-flex gap-4">
                            <div class="stat-item text-center">
                                <div class="stat-value text-white">@(AuthService.CurrentUser?.UserId)</div>
                                <div class="stat-label text-white-50">User ID</div>
                            </div>
                            <div class="stat-item text-center">
                                <div class="stat-value text-white">@(loginHistory.Count)</div>
                                <div class="stat-label text-white-50">Logins</div>
                            </div>
                            <div class="stat-item text-center">
                                <div class="stat-value text-white">
                                    @(AuthService.CurrentUser?.LastLoginDate?.ToString("MMM dd") ?? "N/A")
                                </div>
                                <div class="stat-label text-white-50">Last Login</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="profile-tabs mb-4">
            <button class="tab-btn @(activeTab == "overview" ? "active" : "")"
                    @onclick='() => activeTab = "overview"'>
                <i class="bi bi-person-vcard me-2"></i>Overview
            </button>

            <button class="tab-btn @(activeTab == "security" ? "active" : "")"
                    @onclick='() => activeTab = "security"'>
                <i class="bi bi-shield-lock me-2"></i>Security
            </button>

            <button class="tab-btn @(activeTab == "activity" ? "active" : "")"
                    @onclick='() => activeTab = "activity"'>
                <i class="bi bi-clock-history me-2"></i>Activity
            </button>
        </div>

        <!-- Tab Content -->
        @if (activeTab == "overview")
        {
            <div class="row g-4">
                <!-- Account Details -->
                <div class="col-lg-6">
                    <div class="profile-card h-100">
                        <div class="profile-card-header">
                            <div class="card-header-icon blue">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">Account Details</h5>
                                <small class="text-muted">Your account information</small>
                            </div>
                        </div>
                        <div class="profile-card-body">
                            <div class="info-grid">
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="bi bi-hash"></i>
                                    </div>
                                    <div class="info-content">
                                        <span class="info-label">User ID</span>
                                        <span class="info-value">@AuthService.CurrentUser?.UserId</span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div class="info-content">
                                        <span class="info-label">Login Name</span>
                                        <span class="info-value">@AuthService.CurrentUser?.LoginName</span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="bi bi-envelope"></i>
                                    </div>
                                    <div class="info-content">
                                        <span class="info-label">Email</span>
                                        <span class="info-value">@(AuthService.CurrentUser?.Email ?? "Not set")</span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="bi bi-shield"></i>
                                    </div>
                                    <div class="info-content">
                                        <span class="info-label">Role</span>
                                        <span class="info-value">
                                            <span class="badge @(AuthService.IsAdmin ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary")">
                                                @(AuthService.CurrentUser?.Role ?? "User")
                                            </span>
                                        </span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>
                                    <div class="info-content">
                                        <span class="info-label">Last Login</span>
                                        <span class="info-value">
                                            @(AuthService.CurrentUser?.LastLoginDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A")
                                        </span>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="bi bi-circle-fill" style="color: #22c55e; font-size: 0.6rem;"></i>
                                    </div>
                                    <div class="info-content">
                                        <span class="info-label">Account Status</span>
                                        <span class="info-value">
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="col-lg-6">
                    <div class="profile-card h-100">
                        <div class="profile-card-header">
                            <div class="card-header-icon purple">
                                <i class="bi bi-graph-up"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">Quick Stats</h5>
                                <small class="text-muted">Your activity overview</small>
                            </div>
                        </div>
                        <div class="profile-card-body">
                            <div class="stats-grid">
                                <div class="stat-card blue">
                                    <div class="stat-card-icon">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                    </div>
                                    <div class="stat-card-info">
                                        <span class="stat-card-value">@loginHistory.Count</span>
                                        <span class="stat-card-label">Total Logins</span>
                                    </div>
                                </div>

                                <div class="stat-card green">
                                    <div class="stat-card-icon">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                    <div class="stat-card-info">
                                        <span class="stat-card-value">
                                            @loginHistory.Count(l => l.LoginStatus == "Success")
                                        </span>
                                        <span class="stat-card-label">Successful</span>
                                    </div>
                                </div>

                                <div class="stat-card red">
                                    <div class="stat-card-icon">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                    <div class="stat-card-info">
                                        <span class="stat-card-value">
                                            @loginHistory.Count(l => l.LoginStatus == "Failed")
                                        </span>
                                        <span class="stat-card-label">Failed</span>
                                    </div>
                                </div>

                                <div class="stat-card orange">
                                    <div class="stat-card-icon">
                                        <i class="bi bi-clock"></i>
                                    </div>
                                    <div class="stat-card-info">
                                        <span class="stat-card-value">
                                            @GetDaysSinceLastLogin()
                                        </span>
                                        <span class="stat-card-label">Days Active</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Activity Chart Placeholder -->
                            <div class="activity-mini-chart mt-4">
                                <h6 class="text-muted mb-3">
                                    <i class="bi bi-bar-chart me-2"></i>Login Activity (Last 7 days)
                                </h6>
                                <div class="chart-bars d-flex align-items-end gap-2">
                                    @foreach (var day in GetLast7DaysActivity())
                                    {
                                        <div class="chart-bar-wrapper text-center flex-fill">
                                            <div class="chart-bar" style="height: @(day.Count * 15 + 8)px;"></div>
                                            <small class="text-muted d-block mt-1">@day.Label</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "security")
        {
            <div class="row g-4">
                <!-- Change Password -->
                <div class="col-lg-7">
                    <div class="profile-card">
                        <div class="profile-card-header">
                            <div class="card-header-icon amber">
                                <i class="bi bi-key"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">Change Password</h5>
                                <small class="text-muted">Update your account password</small>
                            </div>
                        </div>
                        <div class="profile-card-body">
                            @if (!string.IsNullOrEmpty(passwordMessage))
                            {
                                <div class="alert-custom @(passwordSuccess ? "success" : "error") mb-4">
                                    <div class="alert-custom-icon">
                                        <i class="bi @(passwordSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                                    </div>
                                    <div class="alert-custom-content">
                                        <strong>@(passwordSuccess ? "Success!" : "Error!")</strong>
                                        <p class="mb-0">@passwordMessage</p>
                                    </div>
                                    <button class="alert-custom-close" @onclick="ClearPasswordMessage">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }

                            <EditForm Model="@changePasswordModel" OnValidSubmit="HandleChangePassword" FormName="ChangePasswordForm">
                                <DataAnnotationsValidator />

                                <div class="form-floating-custom mb-4">
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-lock input-icon"></i>
                                        <InputText type="@(showCurrentPassword ? "text" : "password")"
                                                   class="form-control form-control-lg ps-5"
                                                   placeholder="Current Password"
                                                   @bind-Value="changePasswordModel.CurrentPassword" />
                                        <button type="button" class="toggle-password"
                                                @onclick="() => showCurrentPassword = !showCurrentPassword">
                                            <i class="bi @(showCurrentPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </div>
                                    <label class="custom-label">Current Password</label>
                                    <ValidationMessage For="@(() => changePasswordModel.CurrentPassword)" class="text-danger small mt-1" />
                                </div>

                                <div class="form-floating-custom mb-4">
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-key input-icon"></i>
                                        <InputText type="@(showNewPassword ? "text" : "password")"
                                                   class="form-control form-control-lg ps-5"
                                                   placeholder="New Password"
                                                   @bind-Value="changePasswordModel.NewPassword" />
                                        <button type="button" class="toggle-password"
                                                @onclick="() => showNewPassword = !showNewPassword">
                                            <i class="bi @(showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </div>
                                    <label class="custom-label">New Password</label>
                                    <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-danger small mt-1" />

                                    <!-- Password Strength -->
                                    @if (!string.IsNullOrEmpty(changePasswordModel.NewPassword))
                                    {
                                        <div class="password-strength mt-2">
                                            <div class="strength-bars d-flex gap-1">
                                                @for (int i = 0; i < 4; i++)
                                                {
                                                    <div class="strength-bar @(i < GetPasswordStrength() ? GetStrengthClass() : "")"></div>
                                                }
                                            </div>
                                            <small class="@GetStrengthTextClass()">@GetStrengthText()</small>
                                        </div>
                                    }
                                </div>

                                <div class="form-floating-custom mb-4">
                                    <div class="input-icon-wrapper">
                                        <i class="bi bi-check2-circle input-icon"></i>
                                        <InputText type="@(showConfirmPassword ? "text" : "password")"
                                                   class="form-control form-control-lg ps-5"
                                                   placeholder="Confirm Password"
                                                   @bind-Value="changePasswordModel.ConfirmPassword" />
                                        <button type="button" class="toggle-password"
                                                @onclick="() => showConfirmPassword = !showConfirmPassword">
                                            <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </div>
                                    <label class="custom-label">Confirm New Password</label>
                                    <ValidationMessage For="@(() => changePasswordModel.ConfirmPassword)" class="text-danger small mt-1" />

                                    @if (!string.IsNullOrEmpty(changePasswordModel.ConfirmPassword))
                                    {
                                        <small class="@(changePasswordModel.NewPassword == changePasswordModel.ConfirmPassword ? "text-success" : "text-danger") mt-1 d-block">
                                            <i class="bi @(changePasswordModel.NewPassword == changePasswordModel.ConfirmPassword ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                            @(changePasswordModel.NewPassword == changePasswordModel.ConfirmPassword ? "Passwords match" : "Passwords don't match")
                                        </small>
                                    }
                                </div>

                                <button type="submit" class="btn-gradient w-100" disabled="@isChangingPassword">
                                    @if (isChangingPassword)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-check me-2"></i>
                                        <span>Update Password</span>
                                    }
                                </button>
                            </EditForm>
                        </div>
                    </div>
                </div>

                <!-- Security Tips -->
                <div class="col-lg-5">
                    <div class="profile-card h-100">
                        <div class="profile-card-header">
                            <div class="card-header-icon green">
                                <i class="bi bi-shield-fill-check"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">Security Tips</h5>
                                <small class="text-muted">Keep your account safe</small>
                            </div>
                        </div>
                        <div class="profile-card-body">
                            <div class="security-tips">
                                <div class="tip-item">
                                    <div class="tip-icon bg-primary-subtle">
                                        <i class="bi bi-key-fill text-primary"></i>
                                    </div>
                                    <div class="tip-content">
                                        <strong>Strong Passwords</strong>
                                        <p class="text-muted small mb-0">Use at least 8 characters with uppercase, lowercase, numbers, and symbols.</p>
                                    </div>
                                </div>

                                <div class="tip-item">
                                    <div class="tip-icon bg-success-subtle">
                                        <i class="bi bi-arrow-repeat text-success"></i>
                                    </div>
                                    <div class="tip-content">
                                        <strong>Regular Updates</strong>
                                        <p class="text-muted small mb-0">Change your password every 90 days for better security.</p>
                                    </div>
                                </div>

                                <div class="tip-item">
                                    <div class="tip-icon bg-warning-subtle">
                                        <i class="bi bi-share text-warning"></i>
                                    </div>
                                    <div class="tip-content">
                                        <strong>Don't Share</strong>
                                        <p class="text-muted small mb-0">Never share your password or login credentials with anyone.</p>
                                    </div>
                                </div>

                                <div class="tip-item">
                                    <div class="tip-icon bg-danger-subtle">
                                        <i class="bi bi-box-arrow-right text-danger"></i>
                                    </div>
                                    <div class="tip-content">
                                        <strong>Logout</strong>
                                        <p class="text-muted small mb-0">Always logout from shared or public computers.</p>
                                    </div>
                                </div>

                                <div class="tip-item">
                                    <div class="tip-icon bg-info-subtle">
                                        <i class="bi bi-eye text-info"></i>
                                    </div>
                                    <div class="tip-content">
                                        <strong>Monitor Activity</strong>
                                        <p class="text-muted small mb-0">Check your login history regularly for suspicious activity.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "activity")
        {
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="card-header-icon teal">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">Login History</h5>
                        <small class="text-muted">Your recent login activity</small>
                    </div>
                    <div class="ms-auto">
                        <span class="badge bg-primary-subtle text-primary">
                            @loginHistory.Count Records
                        </span>
                    </div>
                </div>
                <div class="profile-card-body p-0">
                    @if (isLoadingHistory)
                    {
                        <div class="text-center py-5">
                            <div class="loading-dots">
                                <div class="dot"></div>
                                <div class="dot"></div>
                                <div class="dot"></div>
                            </div>
                            <p class="text-muted mt-3">Loading activity...</p>
                        </div>
                    }
                    else if (loginHistory.Any())
                    {
                        <div class="timeline-container">
                            @foreach (var log in loginHistory)
                            {
                                <div class="timeline-item @log.LoginStatus.ToLower()">
                                    <div class="timeline-marker">
                                        <i class="bi @GetTimelineIcon(log.LoginStatus)"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong class="d-block">
                                                    @GetLoginStatusText(log.LoginStatus)
                                                </strong>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i>
                                                    @log.LoginTime.ToString("dd MMM yyyy, hh:mm:ss tt")
                                                </small>
                                            </div>
                                            <span class="status-badge @log.LoginStatus.ToLower()">
                                                @log.LoginStatus
                                            </span>
                                        </div>
                                        <div class="timeline-meta mt-2">
                                            <span class="me-3">
                                                <i class="bi bi-geo-alt me-1"></i>
                                                <code>@(log.IPAddress ?? "Unknown")</code>
                                            </span>
                                            <span>
                                                <i class="bi bi-clock me-1"></i>
                                                @GetTimeAgo(log.LoginTime)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="empty-state-icon">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <h5 class="text-muted mt-3">No Activity Yet</h5>
                            <p class="text-muted">Your login history will appear here</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* ========================================
           PROFILE PAGE BASE
           ======================================== */
    .profile-page {
        background: #f5f7fa;
        min-height: 100vh;
    }

    /* ========================================
           BANNER
           ======================================== */
    .profile-banner {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        padding: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
    }

    .banner-content {
        position: relative;
        z-index: 1;
    }

    .profile-avatar-wrapper {
        position: relative;
    }

    .profile-avatar {
        width: 90px;
        height: 90px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 3px solid rgba(255, 255, 255, 0.4);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        color: white;
        transition: transform 0.3s ease;
    }

        .profile-avatar:hover {
            transform: scale(1.05) rotate(3deg);
        }

    .avatar-status {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 3px solid #764ba2;
    }

        .avatar-status.online {
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.3);
        }

    .profile-badge {
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

        .profile-badge.admin {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border: 1px solid rgba(255, 193, 7, 0.3);
        }

        .profile-badge.user {
            background: rgba(255, 255, 255, 0.15);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .profile-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .stat-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ========================================
           TABS
           ======================================== */
    .profile-tabs {
        display: flex;
        gap: 8px;
        background: white;
        padding: 8px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .tab-btn {
        flex: 1;
        padding: 12px 20px;
        border: none;
        background: transparent;
        border-radius: 12px;
        font-weight: 500;
        color: #64748b;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

        .tab-btn:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

    /* ========================================
           PROFILE CARDS
           ======================================== */
    .profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .profile-card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

    .profile-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 24px;
