@page "/messagestatus"
@using CSMTutorial.Data.Repositories

@inject ITeacherAbsenceService TeacherService
@inject IWhatsAppService WhatsAppService

<style>
    .status-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-header {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        padding: 25px 30px;
        border-radius: 12px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(17, 153, 142, 0.4);
    }

        .page-header h2 {
            margin: 0;
            font-size: 24px;
        }

    /* Filter Card */
    .filter-card {
        background: white;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .filter-row {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1;
        min-width: 150px;
    }

        .filter-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            color: #666;
            font-weight: 500;
        }

        .filter-group input,
        .filter-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
        }

            .filter-group input:focus,
            .filter-group select:focus {
                outline: none;
                border-color: #11998e;
            }

    .filter-buttons {
        display: flex;
        gap: 10px;
    }

    /* Table Styles */
    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .table-header {
        background: #f8f9fa;
        padding: 16px 24px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .table-header h4 {
            margin: 0;
            font-size: 16px;
            color: #333;
        }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #f8f9fa;
        padding: 14px 16px;
        text-align: left;
        font-size: 13px;
        font-weight: 600;
        color: #555;
        border-bottom: 2px solid #e9ecef;
        white-space: nowrap;
    }

    td {
        padding: 14px 16px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 14px;
        color: #333;
    }

    tr:hover {
        background: #f8f9ff;
    }

    /* Status Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-sent {
        background: #d4edda;
        color: #155724;
    }

    .status-failed {
        background: #f8d7da;
        color: #721c24;
    }

    /* Action Buttons */
    .btn-sm {
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-retry {
        background: #ffc107;
        color: #000;
    }

        .btn-retry:hover {
            background: #e0a800;
        }

    .btn-view {
        background: #17a2b8;
        color: white;
    }

        .btn-view:hover {
            background: #138496;
        }

    .btn-refresh {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-refresh:hover {
            box-shadow: 0 4px 12px rgba(17, 153, 142, 0.3);
        }

    .btn-search {
        background: #667eea;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-clear {
        background: #6c757d;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    /* Summary Cards */
    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

        .summary-icon.total {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .summary-icon.sent {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }

        .summary-icon.pending {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .summary-icon.failed {
            background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
        }

    .summary-info h3 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #333;
    }

    .summary-info p {
        margin: 4px 0 0;
        font-size: 13px;
        color: #888;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 20px;
    }

    .page-btn {
        padding: 8px 14px;
        border: 1px solid #ddd;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
    }

        .page-btn:hover {
            background: #f0f0f0;
        }

        .page-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    /* Error Message Cell */
    .error-message {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #dc3545;
        font-size: 12px;
    }

        .error-message:hover {
            white-space: normal;
            overflow: visible;
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }

        .empty-state i {
            font-size: 64px;
            margin-bottom: 16px;
            opacity: 0.5;
        }

    /* Loading */
    .loading-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
    }

    .loader {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #11998e;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Retry All Button */
    .btn-retry-all {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-retry-all:hover {
            box-shadow: 0 4px 12px rgba(240, 147, 251, 0.4);
        }

        .btn-retry-all:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        backdrop-filter: blur(3px);
    }

    .modal-content {
        background: white;
        border-radius: 12px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        animation: modalFadeIn 0.3s ease-out forwards;
    }

    @@keyframes modalFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .modal-header {
        padding: 16px 24px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h4 {
            margin: 0;
            font-size: 18px;
            color: #333;
        }

    .modal-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #888;
        cursor: pointer;
        transition: color 0.2s;
    }

        .modal-close:hover {
            color: #333;
        }

    .modal-body {
        padding: 24px;
    }

    .confirm-item {
        display: flex;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .confirm-label {
        font-weight: 600;
        color: #555;
        width: 80px;
    }

    .confirm-value {
        color: #333;
    }

    .whatsapp-bubble {
        padding: 12px 16px;
        border-radius: 0 12px 12px 12px;
        font-size: 14px;
        color: #333;
        margin-top: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        white-space: pre-wrap; /* Keeps line breaks from the message */
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #eee;
        display: flex;
        justify-content: flex-end;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
        border: none;
    }

    .btn-secondary {
        background: #e2e8f0;
        color: #475569;
    }

        .btn-secondary:hover {
            background: #cbd5e1;
        }
</style>

<div class="status-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2>📊 Message Status Tracking</h2>
        <p>Monitor delivery status and retry failed messages</p>
    </div>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card">
            <div class="summary-icon total">📨</div>
            <div class="summary-info">
                <h3>@totalCount</h3>
                <p>Total Messages</p>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon sent">✅</div>
            <div class="summary-info">
                <h3>@sentCount</h3>
                <p>Sent Successfully</p>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon pending">⏳</div>
            <div class="summary-info">
                <h3>@pendingCount</h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon failed">❌</div>
            <div class="summary-info">
                <h3>@failedCount</h3>
                <p>Failed</p>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-card">
        <div class="filter-row">
            <div class="filter-group">
                <label>From Date</label>
                <input type="date" @bind="filterFromDate" />
            </div>
            <div class="filter-group">
                <label>To Date</label>
                <input type="date" @bind="filterToDate" />
            </div>
            <div class="filter-group">
                <label>Company</label>
                <select @bind="filterCompanyId">
                    <option value="">All Companies</option>
                    @foreach (var company in companies)
                    {
                        <option value="@company.CompanyId">@company.CompanyName</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select @bind="filterStatus">
                    <option value="">All Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Sent">Sent</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="filter-buttons">
                <button class="btn-search" @onclick="ApplyFilters">🔍 Search</button>
                <button class="btn-clear" @onclick="ClearFilters">✕ Clear</button>
                <button class="btn-refresh" @onclick="RefreshData">
                    🔄 Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <div class="table-header">
            <h4>📋 Message Recipients (@recipients.Count records)</h4>
            @if (failedCount > 0)
            {
                <button class="btn-retry-all" @onclick="RetryAllFailed" disabled="@isRetrying">
                    @if (isRetrying)
                    {
                        <span>Retrying...</span>
                    }
                    else
                    {
                        <span>🔁 Retry All Failed (@failedCount)</span>
                    }
                </button>
            }
        </div>

        @if (isLoading)
        {
            <div class="loading-overlay">
                <div class="loader"></div>
            </div>
        }
        else if (recipients.Count == 0)
        {
            <div class="empty-state">
                <div>📭</div>
                <h3>No Messages Found</h3>
                <p>Try adjusting your filters or send a new notification</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Student Name</th>
                            <th>Phone Number</th>
                            <th>Company</th>
                            <th>Message Type</th>
                            <th>Status</th>
                            <th>Sent Date</th>
                            <th>Retry Count</th>
                            <th>Error Message</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (recipient, index) in recipients.Select((r, i) => (r, i)))
                        {
                            <tr>
                                <td>@(index + 1)</td>
                                <td><strong>@recipient.StudentName</strong></td>
                                <td>@recipient.ParentMobile</td>
                                <td>@recipient.CompanyName</td>
                                <td>@recipient.MessageType</td>
                                <td>
                                    <span class="status-badge status-@recipient.Status.ToLower()">
                                        @if (recipient.Status == "Sent")
                                        {
                                            <span>✅</span>
                                        }
                                        else if (recipient.Status == "Failed")
                                        {

                                            <span>❌</span>
                                        }
                                        else
                                        {

                                            <span>⏳</span>
                                        }
                                        @recipient.Status
                                    </span>
                                </td>
                                <td>@(recipient.SentDate?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                                <td>@recipient.RetryCount</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(recipient.ErrorMessage))
                                    {
                                        <span class="error-message" title="@recipient.ErrorMessage">
                                            @recipient.ErrorMessage
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (recipient.Status == "Failed" && recipient.RetryCount < 3)
                                    {
                                        <button class="btn-sm btn-retry" @onclick="() => RetryMessage(recipient)">
                                            🔄 Retry
                                        </button>
                                    }
                                    <button class="btn-sm btn-view" @onclick="() => ViewMessage(recipient)">
                                        👁️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination">
                <button class="page-btn" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    ← Prev
                </button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    var pageNum = i;
                    <button class="page-btn @(currentPage == pageNum ? "active" : "")"
                            @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button class="page-btn" @onclick="NextPage" disabled="@(currentPage == totalPages)">
                    Next →
                </button>
            </div>
        }
    </div>
</div>

<!-- View Message Modal -->
@if (showMessageModal && selectedRecipient != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h4>📩 Message Details</h4>
                <button class="modal-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="confirm-item">
                    <span class="confirm-label">Student</span>
                    <span class="confirm-value">@selectedRecipient.StudentName</span>
                </div>
                <div class="confirm-item">
                    <span class="confirm-label">Phone</span>
                    <span class="confirm-value">@selectedRecipient.ParentMobile</span>
                </div>
                <div class="confirm-item">
                    <span class="confirm-label">Status</span>
                    <span class="status-badge status-@selectedRecipient.Status.ToLower()">
                        @selectedRecipient.Status
                    </span>
                </div>
                <div style="margin-top: 20px;">
                    <label class="form-label">Message Content:</label>
                    <div class="whatsapp-bubble" style="background: #dcf8c6;">
                        @selectedRecipient.MessageBody
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CompanyDropdown> companies = new();
    private List<TeacherAbsenceRecipient> recipients = new();

    // Filters
    private DateTime? filterFromDate = DateTime.Today.AddDays(-7);
    private DateTime? filterToDate = DateTime.Today;
    private int? filterCompanyId;
    private string filterStatus = "";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalPages = 1;

    // Summary
    private int totalCount = 0;
    private int sentCount = 0;
    private int pendingCount = 0;
    private int failedCount = 0;

    // State
    private bool isLoading = false;
    private bool isRetrying = false;
    private bool showMessageModal = false;
    private TeacherAbsenceRecipient selectedRecipient;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
        await LoadData();
    }

    private async Task LoadCompanies()
    {
        companies = await TeacherService.GetCompaniesAsync();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            recipients = await TeacherService.GetMessageReportAsync(
                null,
                filterFromDate,
                filterToDate,
                filterCompanyId,
                string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
                currentPage,
                pageSize
            );

            // Calculate summary
            totalCount = recipients.Count;
            sentCount = recipients.Count(r => r.Status == "Sent");
            pendingCount = recipients.Count(r => r.Status == "Pending");
            failedCount = recipients.Count(r => r.Status == "Failed");

            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        filterFromDate = DateTime.Today.AddDays(-7);
        filterToDate = DateTime.Today;
        filterCompanyId = null;
        filterStatus = "";
        currentPage = 1;
        await LoadData();
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task RetryMessage(TeacherAbsenceRecipient recipient)
    {
        try
        {
            var response = await WhatsAppService.SendMessageAsync(
                recipient.ParentMobile,
                recipient.MessageBody
            );

            var newStatus = response.Success ? "Sent" : "Failed";
            await TeacherService.UpdateRecipientStatusAsync(
                recipient.RecipientId,
                newStatus,
                response.ErrorMessage
            );

            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Retry error: {ex.Message}");
        }
    }

    private async Task RetryAllFailed()
    {
        try
        {
            isRetrying = true;
            StateHasChanged();

            var failedRecipients = recipients.Where(r => r.Status == "Failed" && r.RetryCount < 3).ToList();

            foreach (var recipient in failedRecipients)
            {
                await RetryMessage(recipient);
                await Task.Delay(500); // Prevent API throttling
            }
        }
        finally
        {
            isRetrying = false;
            await LoadData();
        }
    }

    private void ViewMessage(TeacherAbsenceRecipient recipient)
    {
        selectedRecipient = recipient;
        showMessageModal = true;
    }

    private void CloseModal()
    {
        showMessageModal = false;
        selectedRecipient = null;
    }

    private void GoToPage(int page)
    {
        currentPage = page;
        _ = LoadData();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            _ = LoadData();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            _ = LoadData();
        }
    }
}